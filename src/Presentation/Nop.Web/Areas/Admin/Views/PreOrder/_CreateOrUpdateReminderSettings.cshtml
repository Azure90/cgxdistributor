        <div class="form-group row mt-3">
            <div class="col-md-9 offset-md-3">
                <button type="button" id="UpdateReminderSettings" class="btn btn-primary">Update settings</button>
            </div>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            $('#UpdateReminderSettings').click(function () {

                var postData = {
                    InitialReminderTemplateId: $("#@Html.IdFor(model => model.ReminderSettings.InitialReminderTemplateId)").val(),
                    InitialReminderDays: $("#@Html.IdFor(model => model.ReminderSettings.InitialReminderDays)").val(),
                    InitialReminderDays: $("#@Html.IdFor(model => model.ReminderSettings.InitialReminderDays)").val(),
                    InitialReminderActive: $("#@Html.IdFor(model => model.ReminderSettings.InitialReminderActive)").is(":checked"),

                    EditableReminderTemplateId: $("#@Html.IdFor(model => model.ReminderSettings.EditableReminderTemplateId)").val(),
                    EditableReminderDays: $("#@Html.IdFor(model => model.ReminderSettings.EditableReminderDays)").val(),
                    EditableReminderActive: $("#@Html.IdFor(model => model.ReminderSettings.EditableReminderActive)").is(":checked"),

                    FinalReminderTemplateId: $("#@Html.IdFor(model => model.ReminderSettings.FinalReminderTemplateId)").val(),
                    FinalReminderDays: $("#@Html.IdFor(model => model.ReminderSettings.FinalReminderDays)").val(),
                    FinalReminderActive: $("#@Html.IdFor(model => model.ReminderSettings.FinalReminderActive)").is(":checked"),

                    DeliveryReminderTemplateId: $("#@Html.IdFor(model => model.ReminderSettings.DeliveryReminderTemplateId)").val(),
                    DeliveryReminderDays: $("#@Html.IdFor(model => model.ReminderSettings.DeliveryReminderDays)").val(),
                    DeliveryReminderActive: $("#@Html.IdFor(model => model.ReminderSettings.DeliveryReminderActive)").is(":checked")
                };

                // Validation
                if (!postData.InitialReminderTemplateId || postData.InitialReminderTemplateId === "0") {
                    showValidationSummary("Please select the Initial Reminder email template.");
                    return;
                }

                // if (!postData.EditableReminderTemplateId || postData.EditableReminderTemplateId === "0") {
                //     showValidationSummary("Please select the Editable Reminder email template.");
                //     return;
                // }

                if (!postData.FinalReminderTemplateId || postData.FinalReminderTemplateId === "0") {
                    showValidationSummary("Please select the Final Reminder email template.");
                    return;
                }

                if (!postData.DeliveryReminderTemplateId || postData.DeliveryReminderTemplateId === "0") {
                    showValidationSummary("Please select the Delivery Reminder email template.");
                    return;
                }

                if (isNaN(postData.InitialReminderDays) || parseInt(postData.InitialReminderDays) < 0) {
                    showValidationSummary("Initial Reminder Days must be a valid number greater than or equal to 0.");
                    return;
                }

                // if (isNaN(postData.EditableReminderDays) || parseInt(postData.EditableReminderDays) < 0) {
                //     showValidationSummary("Editable Reminder Days must be a valid number greater than or equal to 0.");
                //     return;
                // }

                if (isNaN(postData.FinalReminderDays) || parseInt(postData.FinalReminderDays) < 0) {
                    showValidationSummary("Final Reminder Days must be a valid number greater than or equal to 0.");
                    return;
                }

                if (isNaN(postData.DeliveryReminderDays) || parseInt(postData.DeliveryReminderDays) < 0) {
                    showValidationSummary("Delivery Reminder Days must be a valid number greater than or equal to 0.");
                    return;
                }

                $('#UpdateReminderSettings').prop('disabled', true);

                addAntiForgeryToken(postData);

                $.ajax({
                    cache: false,
                    type: "POST",
                    url: "@Html.Raw(Url.Action("UpdatePreOrderReminderSettings", "Preorder"))",
                    data: postData,
                    beforeSend: function () {

                        hideSummary();
                    },
                    success: function (data, textStatus, jqXHR) {
                        if (data.Result) {
                            showSuccessSummary("Reminder settings saved successfully.");
                        } else {
                            showValidationSummary(data.Message || "An error occurred while saving reminder settings.");
                            display_nop_error(data);
                        }
                    },
                    complete: function (jqXHR, textStatus) {
                        $('#UpdateReminderSettings').attr('disabled', false);
                    }
                });
            });
        });

        function showValidationSummary(message) {
            $("#reminderSuccessSummary").hide().text("");

            $("#reminderValidationSummary")
                .text(message)
                .show();

            $(".validation-summary-container").show();
        }

        function showSuccessSummary(message) {
            $("#reminderValidationSummary").hide().text("");

            $("#reminderSuccessSummary")
                .text(message)
                .show();

            $(".validation-summary-container").show();

            setTimeout(function () {
                $("#reminderSuccessSummary").fadeOut(300);
                $(".validation-summary-container").fadeOut(300);
            }, 3000);
        }

        function hideSummary() {
            $("#reminderValidationSummary").hide().text("");
            $("#reminderSuccessSummary").hide().text("");

            $(".validation-summary-container").hide();
        }
    </script>
</div>

