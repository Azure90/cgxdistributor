@using Nop.Core.Domain.Orders.PreOrders
@using Nop.Web.Areas.Admin.Models.Orders.PreOrders

@model PreOrderModel


<div class="card card-outline card-custom-preorders" id="CustomPreOrders-message-info">
    <div class="card-header with-border clearfix">
        <div class="card-title">
            <i class="fas fa-envelope-open"></i> Message Templates Info
        </div>
    </div>

    <div class="card-body">
        <div class="form-group row validation-summary-container mb-2" style="display:none;">
            <div class="col-md-3"></div>
            <div class="col-md-9">
                <span id="reminderValidationSummary" class="field-validation-error"></span>
                <span id="reminderSuccessSummary" class="text-success" style="display:none;"></span>
            </div>
        </div>    

        <div class="form-group row">
            <div class="col-md-3">
                <div class="label-wrapper">
                    <label class="col-form-label" for="intReminderActive">Initial Reminder Active</label>
                    <div title="" data-toggle="tooltip" class="ico-help" data-original-title="Check to make the intital reminder template active.">
                        <i class="fas fa-question-circle"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="ReminderSettings.InitialReminderActive" />
                <span asp-validation-for="ReminderSettings.InitialReminderActive"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <div class="label-wrapper">
                    <label class="col-form-label" for="InitialTemplateId">Select Initial Reminder Template</label>
                    <div title="" data-toggle="tooltip" class="ico-help" data-original-title="Select eligible customer roles for pre-order.">
                        <i class="fas fa-question-circle"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-9">
                <div class="input-group-append input-group-required">
                    <div class="input-group">
                        <nop-select asp-for="ReminderSettings.InitialReminderTemplateId" asp-items="@Model.ReminderSettings.AvailableMessageTemplates" asp-multiple="false" />
                    </div>
                    <div class="input-group-btn">
                        <nop-required />
                    </div>
                </div>

                <script>
                    $(document).ready(function () {
                        var categoryIdsInput = $('#@Html.IdFor(model => Model.ReminderSettings.InitialReminderTemplateId)').data("kendoMultiSelect");
                        categoryIdsInput.setOptions({
                            autoClose: false,
                            filter: "contains"
                        });

                    @if (Model.ReminderSettings.AvailableMessageTemplates.Count == 0)
                    {
                        <text>
                                categoryIdsInput.setOptions({
                                    enable: false,
                                    placeholder: '@T("Admin.Catalog.Products.Fields.Categories.NoCategoriesAvailable")'
                                });
                            categoryIdsInput._placeholder();
                            categoryIdsInput._enable();
                        </text>
                    }                                                                                                                                                                                                });
                </script>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <div class="label-wrapper">
                    <label class="col-form-label" for="InitialReminderDay">Initial Reminder Days</label>
                    <div title="" data-toggle="tooltip" class="ico-help" data-original-title="">
                        <i class="fas fa-question-circle"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <nop-editor asp-for="ReminderSettings.InitialReminderDays" asp-required="true" />
                <span asp-validation-for="ReminderSettings.InitialReminderDays"></span>
            </div>            
        </div>

