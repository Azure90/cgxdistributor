<script>
    $('#PayNowButton').change(function () {
        var val = $(this).prop("checked");

        var postData = {
            priceStatus: val
        };
        addAntiForgeryToken(postData);

        $.ajax({
            cache: false,
            type: "POST",
            url: "@(Url.Action("SetActiveInactivePayNowButton", "InvoicePaymentOption"))",
            data: postData,
            success: function (data) {
                if (data.Status == true)
                    $("#showrangemsg").text("Pay now Button are Activated Successfully.").css("color", "Green").css("font-weight", "600").css("display", "block").delay(1000).fadeOut(500);
                else
                    $("#showrangemsg").text("Pay now Button are Deactivated Successfully.").css("color", "Red").css("font-weight", "600").css("display", "block").delay(1000).fadeOut(500);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert('Something went wrong !!');
            }
        });
    });
</script>
<script>
    $('#PayNowOption').change(function () {
        var val = $(this).prop("checked");

        var postData = {
            priceStatus: val
        };
        addAntiForgeryToken(postData);

        $.ajax({
            cache: false,
            type: "POST",
            url: "@(Url.Action("SetActiveInactivePayNowOption", "InvoicePaymentOption"))",
            data: postData,
            success: function (data) {
                if (data.Status == true)
                    $("#showrangemsg").text("Pay now Option are Activated Successfully.").css("color", "Green").css("font-weight", "600").css("display", "block").delay(1000).fadeOut(500);
                else
                    $("#showrangemsg").text("Pay now Option are Deactivated Successfully.").css("color", "Red").css("font-weight", "600").css("display", "block").delay(1000).fadeOut(500);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert('Something went wrong !!');
            }
        });
    });
</script>
