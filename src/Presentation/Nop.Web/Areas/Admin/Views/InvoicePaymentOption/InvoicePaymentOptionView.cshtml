    function Delete(id) {
        if (confirm("Are you sure you want to delete this entry? Any related content will also be lost.Warning: This action cannot be undone.") == true) {

            var postData = {
                id: id
            };
            addAntiForgeryToken(postData);
            $.ajax({
                type: 'Post',
                url: '/Admin/InvoicePaymentOption/Delete',
                data: postData,
                success: function (data) {
                    window.location.reload();

                }
            })
            return true;
        } else {

            return false;
        }


    }
</script>


