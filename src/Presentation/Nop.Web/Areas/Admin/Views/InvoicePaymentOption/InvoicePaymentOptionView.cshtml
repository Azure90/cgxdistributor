                    <div class="card card-default">
                        <div class="card-body">
                            <div class="panel panel-default">
                                <div class="panel-body">
                                    <table id="SpecialPriceList" class="table table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>PaymentTittle</th>
                                                <th>paymentOption</th>
                                                <th>CustomerRole</th>
                                                <th>Paynow Button</th>
                                                <th>payment option</th>
                                                <th>Active</th>                                               
                                                <th>Action</th>                                               
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var item in Model.ModelList)
                                            {
                                                <tr>
                                                    <td>@Html.Raw(item.PaymentTittle)</td>
                                                    <td>@Html.Raw(@item.paymentOption)</td>
                                                    <td>@item.CustomerRoleName</td>
                                                    <td>@item.PaynowButton</td>
                                                    <td>@item.Paynowtoption</td>
                                                    <td>@item.Active</td>                                                    
                                                    <td>
                                                        <button type="button" class="btn btn-success" onclick="location.href='@Url.Action("editInvoicePaymentOption","InvoicePaymentOption", new { @item.Id })'">Edit</button>

                                                        <button type="button" class="btn btn-danger" id="dltcontent" onclick="Delete(@item.Id)">Delete</button>

                                                    </td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
