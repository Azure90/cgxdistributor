@model Nop.Web.Areas.Admin.Models.CustomPage.CustomPageModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.CustomPage.List").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Custom Page");
}
<style>

    .das-content__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-direction: row-reverse;
        padding: 10px 20px;
    }

    .dropdown-Outer label {
        margin: 0 10px 0 0;
    }

    .dropdown-Outer select {
        min-height: 40px;
        width: 300px;
        padding: 0 10px;
    }

    #CustomPageList tr:nth-child(even) {
        background: #f5f5f5;
    }

    #CustomPageList td img {
        max-width: 100px;
        height: 100px;
    }

    .panel-body {
        background: #fff;
        padding: 20px;
    }

    #CustomPageList td img {
        object-fit: contain;
    }
</style>

<div class="das-content__header">
    <button type="button" class="btn bg-blue" onclick="location.href='@Url.Action("Index","CustomPage")'">
        <i class="fa fa-plus-square"></i>
        Create
    </button>
    <div class="dropdown-Outer">

    <label>Language</label>

    <select name="LanguageId" id="CustomLanguage" value="selected" asp-for="LanguageId">
    <option value="">Select Language</option>
    <option value="1">English</option>
    <option value="2">Français</option>

    </select>
    </div>
</div>
<div class="panel panel-default">
    <div class="panel-body">
        <table id="CustomPageList" class="table table-bordered">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Active</th>
                    <th>Image</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model.ModelList)
                {
                    <tr class="tr_@item.LanguageId AlltrLanguageId">
                        <td>@item.Title</td>
                        <td>@item.Description</td>
                        <td>@item.Active</td>
                        <td><img src="~/Uploads/@item.Image" height="200px" width="200px"></img></td>
                        <td>
                            <button type="button" class="btn btn-success" onclick="location.href='@Url.Action("Index","CustomPage", new { @item.ID })'">Edit</button>
                            @*<button type="button" onclick="location.href='@Url.Action("Delete","CustomPage", new { @item.ID })'" >Delete</button>*@
                            <button type="button" class="btn btn-danger" id="dltcontent" onclick="Delete(@item.ID)">Delete</button>

                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>
@*<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.1/jquery.min.js" integrity="sha512-aVKKRRi/Q/YV+4mjoKBsE4x3H+BkegoM/em46NNlCqNTmUYADjBbeNefNxYV7giUp0VxICtqdrbqU7iVaeZNXA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>*@
<script>
    //$("#CustomPageList").dataTable();
    $('#CustomPageList').DataTable({
        //"lengthMenu": [[5, 10, 20, 50, 100], [5, 10, 20, 50, 100]]     //[[100, "All", 50, 25], [100, "All", 50, 25]]
    });
</script>
<script>

    function Delete(id) {
        if (confirm("Are you sure you want to delete this entry? Any related content will also be lost.Warning: This action cannot be undone.") == true) {

            var postData = {
                id: id
            };
            addAntiForgeryToken(postData);
            $.ajax({
                type: 'Post',
                url: '/Admin/CustomPage/Delete',
                data: postData,
                success: function (data) {
                    location.href = "/Admin/CustomPage/CustomListPage";

                }
            })
            return true;
        } else {

            return false;
        }


    }

    $("#CustomLanguage").change(function () {
        var id = $('#CustomLanguage :selected').val();
        if (id > 0) {
            $(".AlltrLanguageId").css("display", "none");
            $(".tr_" + id).css("display", "table-row");
        }
        else {
            $(".AlltrLanguageId").css("display", "table-row");
        }
    });
</script>