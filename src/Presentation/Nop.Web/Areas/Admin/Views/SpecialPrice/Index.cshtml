@model Nop.Web.Areas.Admin.Controllers.SpecialPriceController.SpecialPriceModel
@{
    //page title
    ViewBag.PageTitle = T("Admin.Promotions.SpecialPrice").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Special Price");
}
<style>
    .panel-body {
        background: #fff;
        padding: 20px;
    }
</style>
<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Admin.Promotions.SpecialPrice")
    </h1>
  
</div>
<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">               

                <div class="card card-default">
                    <div class="card-body">
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <table id="SpecialPriceList" class="table table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Product Name</th>
                                            <th>SKU</th>
                                            <th>Customer Name</th>
                                            <th>BPCode</th>
                                            <th>Price</th>
                                            <th>Valid from</th>
                                            <th>Valid To</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in Model.data)
                                        {
                                            <tr>
                                                <td>@item.ProductName</td>
                                                <td>@item.SKU</td>
                                                <td>@item.CustomerName</td>
                                                <td>@item.BPCode</td>
                                                <td>@item.Price</td>
                                                <td>@item.ValidFrom</td>
                                                <td>@item.ValidTo</td>
                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



