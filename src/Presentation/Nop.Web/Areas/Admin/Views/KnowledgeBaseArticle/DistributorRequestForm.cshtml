@using Nop.Web.Models.KnowledgeBaseArticle;
@model KnowledgeBaseArticleModel
@{
    ViewBag.PageTitle = "Distributor Request Form";
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Distributor Request Form");
}
<style>
    .two__Form .mb-3 {
        margin-bottom: 10px !important;
    }

    .topForm {
        margin-bottom: 30px;
        padding-bottom: 30px;
        border-bottom: 1px solid #999
    }

    .two__Form h2 {
        background-color: #e2e2e2;
        padding: 5px 15px
    }
</style>
<div class="px-4 py-5 two__Form">
    <h2>Distributor for INTL</h2>
    <div class="form-group row">
        <div class="col-md-3">
            <label class="control-label" for="ActiveInactive" title="">
                Distributor Request Form(Active / InActive)
            </label>
        </div>
        <div class="col-md-4">
            <input type="checkbox" id="DistributorReques"
            @(Convert.ToBoolean(ViewBag.DistributorRequesActive) ? "checked" : "")>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-8 col-md-offset-4">
            <span id="showrangemsg"></span>
        </div>
    </div>
    <form id="DistributorRequestForm " class="topForm" asp-action="DistributorRequestBanner">
        <div class="mb-3 row">
            <div class="col-md-3">
                <label>Banner Image</label>
            </div>
            <div class="col-md-4">
                <nop-editor asp-for="DistributorRequestBannerImage" />
                <span asp-validation-for="DistributorRequestBannerImage"></span>
            </div>
        </div>
        <div class="">
            <div class="mb-3 row">
                <div class="col-md-3">
                    <nop-label asp-for="DistributorRequestLabel" />
                </div>
                <div class="col-md-4">
                    <nop-editor asp-for="DistributorRequestLabel" />
                    <span asp-validation-for="DistributorRequestLabel"></span>
                </div>
            </div>
            <div class="mb-3 row">
                <div class="col-md-3">
                    <nop-label asp-for="DistributorRequesturl" />
                </div>
                <div class="col-md-4">
                    <nop-editor asp-for="DistributorRequesturl" />
                    <span asp-validation-for="DistributorRequesturl"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Submit</button>
        </div>

        <div class="row">
            <div class="col-md-12">
            </div>
        </div>
        <p class="mt-3"><img src="~/Uploads/@ViewBag.DistributorRequestBannerImage1" height="200px" width="200px" style="object-fit:cover"></img></p>
    </form>
    <h2>Distributor for USD</h2>
    <div class="form-group row">
        <div class="col-md-3">
            <label class="control-label" for="ActiveInactive" title="">
                Distributor Request Usd Form(Active / InActive)
            </label>
        </div>
        <div class="col-md-4">
            <input type="checkbox" id="DistributorRequesusd"
            @(Convert.ToBoolean(ViewBag.DistributorRequestusdActive) ? "checked" : "")>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-8 col-md-offset-4">
            <span id="showrangemsgusd"></span>
        </div>
    </div>
    <form id="DistributorRequestBannerforusd" asp-action="DistributorRequestBannerforusd">
        <div class="mb-3 row">
            <div class="col-md-3">
                <label>Banner Image</label>
            </div>
            <div class="col-md-4">
                <nop-editor asp-for="DistributorRequestBannerusdImage" />
                <span asp-validation-for="DistributorRequestBannerusdImage"></span>
            </div>
        </div>
        <div class="">
            <div class="mb-3 row">
                <div class="col-md-3">
                    <nop-label asp-for="DistributorRequestusdLabel" />
                </div>
                <div class="col-md-4">
                    <nop-editor asp-for="DistributorRequestusdLabel" />
                    <span asp-validation-for="DistributorRequestusdLabel"></span>
                </div>
            </div>
            <div class="mb-3 row">
                <div class="col-md-3">
                    <nop-label asp-for="DistributorRequestusdurl" />
                </div>
                <div class="col-md-4">
                    <nop-editor asp-for="DistributorRequestusdurl" />
                    <span asp-validation-for="DistributorRequestusdurl"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Submit</button>
        </div>

        <div class="row">
            <div class="col-md-12">
            </div>
        </div>
        <p class="mt-3"><img src="~/Uploads/@ViewBag.DistributorRequestBannerusdImage1" height="200px" width="200px" style="object-fit:cover"></img></p>
    </form>
</div>
<script>
    $(document).ready(function () {

        $("#DistributorRequestForm").submit(function (event) {
            event.preventDefault(); // Prevent the form from submitting the traditional way

            var formData = new FormData(this);

            $.ajax({
                url: '/Admin/KnowledgeBaseArticle/DistributorRequestBanner',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    window.location.reload();
                },
                error: function (xhr, status, error) {

                }
            });
        });
    });
</script>
<script>
    $(document).ready(function () {

        $("#DistributorRequestBannerforusd").submit(function (event) {
            event.preventDefault(); // Prevent the form from submitting the traditional way

            var formData = new FormData(this);

            $.ajax({
                url: '/Admin/KnowledgeBaseArticle/DistributorRequestBannerforusd',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    window.location.reload();
                },
                error: function (xhr, status, error) {

                }
            });
        });
    });
</script>
<script>
    $('#DistributorReques').change(function () {
        var val = $("#DistributorReques").prop("checked");
        var val1 = $("#DistributorRequesusd").prop("checked");

        var postData = {
            priceStatus: val,
            usdstatus: val1
        };
        addAntiForgeryToken(postData);

        $.ajax({
            cache: false,
            type: "POST",
            url: "@(Url.Action("SetActiveInactiveDistributorRequest", "KnowledgeBaseArticle"))",
            data: postData,
            success: function (data) {
                if (val == true)
                    $("#showrangemsg").text("Distributor Request form are Activated Successfully.").css("color", "Green").css("font-weight", "600").css("display", "block").delay(1000).fadeOut(500);
                else
                    $("#showrangemsg").text("Distributor Request form are Deactivated Successfully.").css("color", "Red").css("font-weight", "600").css("display", "block").delay(1000).fadeOut(500);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert('Something went wrong !!');
            }
        });
    });

    $('#DistributorRequesusd').change(function () {
        var val = $("#DistributorReques").prop("checked");
        var val1 = $("#DistributorRequesusd").prop("checked");
        debugger
        var postData = {
            priceStatus: val,
            usdstatus: val1
        };
        addAntiForgeryToken(postData);

        $.ajax({
            cache: false,
            type: "POST",
            url: "@(Url.Action("SetActiveInactiveDistributorRequest", "KnowledgeBaseArticle"))",
            data: postData,
            success: function (data) {
                if (val1 == true)
                    $("#showrangemsgusd").text("Distributor Request form are Activated Successfully.").css("color", "Green").css("font-weight", "600").css("display", "block").delay(1000).fadeOut(500);
                else
                    $("#showrangemsgusd").text("Distributor Request form are Deactivated Successfully.").css("color", "Red").css("font-weight", "600").css("display", "block").delay(1000).fadeOut(500);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert('Something went wrong !!');
            }
        });
    });


</script>