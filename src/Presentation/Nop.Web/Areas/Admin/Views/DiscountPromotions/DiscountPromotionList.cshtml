@model Nop.Web.Areas.Admin.Models.DiscountPromotions.DiscountPromotionModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Promotions.DiscountsPromotion").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Discounts Promotion");
}
@Html.AntiForgeryToken()
<div class="margin-bottom customer-days-container container-fluid py-3 px-3">
    <div class="row">
        <div class="col-md-auto">
            <a style="margin-top: 38px" href="@Url.Action("addoreditDiscountPromotion")" class="btn bg-blue">
                <i class="fa fa-plus-square"></i>
                @T("Admin.Common.AddNew")
            </a>
        </div>
        <div class="col-md-3" data_spnid="spnQuestion">
            <nop-label asp-for="DaysforNewPurchasers" />
            <nop-editor asp-for="DaysforNewPurchasers" />
            <span asp-validation-for="DaysforNewPurchasers"></span>
        </div>
        <div class="col-md-3" data_spnid="spnQuestion">
            <nop-label asp-for="DaysforLostCustomers" />
            <nop-editor asp-for="DaysforLostCustomers" />
            <span asp-validation-for="DaysforLostCustomers"></span>
        </div>
        <div class="col-md-12">
            <span class="spntext"></span>
        </div>
    </div>
 </div>
@* <div class="form-group">
    <div class="col-md-4">
        <label class="control-label" for="ActiveInactive" title="">
            Discount Promotion (Active / InActive)
        </label>
    </div>
    <div class="col-md-8">
        <input type="checkbox" id="activeInactive" checked="@ViewBag.RewardPointActive">
    </div>
</div> *@
<div class="form-group">
    <div class="col-md-8 col-md-offset-4">
        <span id="showrangemsg"></span>
    </div>
</div>
<div class="panel panel-default container-fluid px-3">
    <div class="panel-body">
        <table id="CustomPageList" class="table table-bordered">
            <thead class="thead-light">
                <tr>
                    <th>Discount Code</th>
                    <th>Discount Promotion Type</th>
                    <th>Order Count</th>
                    <th>Add Days</th>
                    <th>Active</th>
                    <th>Created Date</th>                    
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model.ModelList)
                {
                    <tr class="tr_@item.Id AlltrLanguageId">
                        <td>@item.DiscountCode</td>
                        <td>@(item.DiscountPromotionType == 1 ? "New Purchaser" : "Lost Customer")</td>
                        <td>@item.OrderCount</td>
                        <td>@item.AddDays</td>
                        <td>@item.Active</td>
                        <td>@item.CreatedDate</td>
                        <td>
                            <button type="button" class="btn btn-success" onclick="location.href='@Url.Action("addoreditDiscountPromotion","DiscountPromotions", new { @item.Id })'">Edit</button>
                            @*<button type="button" onclick="location.href='@Url.Action("Delete","CustomPage", new { @item.ID })'" >Delete</button>*@
                            <button type="button" class="btn btn-danger" id="dltcontent" onclick="Delete(@item.Id)">Delete</button>

                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>
<script>



    function Delete(id) {
        if (confirm("Are you sure you want to delete this entry? Any related content will also be lost.Warning: This action cannot be undone.") == true) {

            var postData = {
                id: id
            };
            addAntiForgeryToken(postData);
            $.ajax({
                type: 'Post',
                url: '/Admin/DiscountPromotions/Delete',
                data: postData,
                success: function (data) {
                    location.href = "/Admin/DiscountPromotions/DiscountPromotionList";

                }
            })
            return true;
        } else {

            return false;
        }


    }
</script>

<script>
    $('.customer-days-container input').change(function () {
        var DaysforNewPurchasers = $("#DaysforNewPurchasers").val();
        var DaysforLostCustomers = $("#DaysforLostCustomers").val();

        var postData = {
            DaysforNewPurchasers: DaysforNewPurchasers,
            DaysforLostCustomers: DaysforLostCustomers
        };
        addAntiForgeryToken(postData);

        $.ajax({
            cache: false,
            type: "POST",
            url: "@(Url.Action("DaysforNewPurchasers", "DiscountPromotions"))",
            data: postData,
            success: function (data) {
                if (data.Status == 1)
                    $("#showrangemsg").text("Data Successfully saved.").css("color", "Green").css("font-weight", "600").css("display", "block").delay(1000).fadeOut(500);
                else
                    $("#showrangemsg").text("Data Not saved.").css("color", "Red").css("font-weight", "600").css("display", "block").delay(1000).fadeOut(500);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert('Something went wrong !!');
            }
        });
    });


</script>