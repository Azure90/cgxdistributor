<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@simonwep/pickr/dist/themes/classic.min.css" />
<script src="https://cdn.jsdelivr.net/npm/@@simonwep/pickr"></script>
<script>
    const pickr = Pickr.create({
        el: '#color-picker',
        theme: 'classic', // or 'monolith', 'nano'

        default: '@Model.StoreInformationSettings.ChatbotLabelColor',

        components: {
            preview: true,
            opacity: true,
            hue: true,

            interaction: {
                hex: true,
                rgba: true,
                input: true,
                save: true
            }
        }
    });

    pickr.on('save', (color, instance) => {
        const hex = color.toHEXA().toString();
        document.getElementById('colorValue').value = hex;
        pickr.hide(); // <-- Close the color picker
    });
</script>

<script>
    function rebuildEmbeddings() {
        $.ajax({
            url: '/MedicalChat/RebuildEmbeddings',
            method: 'get',
            success: function (data) {
                alert(data); // show success message
            },
            error: function (err) {
                alert("Error rebuilding embeddings");
            }
        });
    }
</script>
<script>
    $("#ImageFile").on("change", function () {
        var formData = new FormData();
        var file = this.files[0];

        if (file) {
            formData.append("BannerImage", file);

            $.ajax({
                url: '/Admin/Setting/Saveimage',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    // Refresh or show success message
                    window.location.reload();
                },
                error: function (xhr, status, error) {
                    console.error("Upload failed:", error);
                }
            });
        }
    });


    $('#ChatBotAccessButtonCHECKBOX').change(function () {
        var val = $("#ChatBotAccessButtonCHECKBOX").prop("checked");
        if (val == true) {

            $("#ChatBotAccessform").css("display", "block");
        }
        else {

            $("#ChatBotAccessform").css("display", "none");;
        }
        var val1 = $("#StoreInformationSettings_ChatBotAccessButton").val();

        var postData = {
            ChatBotButtoncheckbox: val,
            ChatBotButtoninput: val1
        };
        addAntiForgeryToken(postData);

        $.ajax({
            cache: false,
            type: "POST",
            url: "@(Url.Action("ChatBotButton", "Setting"))",
            data: postData,
            success: function (data) {
                if (val == true)
                    $("#showrangemsg").text("Chat Bot  are Activated Successfully.").css("color", "Green").css("font-weight", "600").css("display", "block").delay(1000).fadeOut(500);
                else
                    $("#showrangemsg").text("Chat Bot  are Deactivated Successfully.").css("color", "Red").css("font-weight", "600").css("display", "block").delay(1000).fadeOut(500);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert('Something went wrong !!');
            }
        });
    })
    $(document).ready(function () {

        $("#ChatBotAccessbutton").click(function (event) {
            var val = $("#ChatBotAccessButtonCHECKBOX").prop("checked");
            var val1 = $("#StoreInformationSettings_ChatBotAccessButton").val();
            var postData = {
                ChatBotButtoncheckbox: val,
                ChatBotButtoninput: val1
            };
            addAntiForgeryToken(postData);
            $.ajax({
                url: '/Admin/Setting/ChatBotButton',
                type: 'POST',
                data: postData, // send as standard form data
                success: function (response) {
                    window.location.reload();
                },
                error: function (xhr, status, error) {
                    console.log("Error:", xhr.responseText);
                }
            });
        });
    });
</script>