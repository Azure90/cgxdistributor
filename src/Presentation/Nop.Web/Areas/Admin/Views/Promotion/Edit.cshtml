@model CustomPromotionModel

@{
    //page title
    ViewBag.Title = T("Admin.Catalog.Manufacturers.EditManufacturerDetails").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Promotions");
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "promotion-form" }))
{
    @Html.AntiForgeryToken()
    <div class="content-header clearfix">
        <h1 class="float-left">
            Edit Price Range Discount
            <small><i class="fa fa-arrow-circle-left"></i>@Html.ActionLink("back to promotion list", "List")</small>
        </h1>
        <div class=" float-right">
            <button type="submit" name="save" class="btn bg-blue">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn bg-blue">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            <span id="promotion-delete" class="btn bg-red">
                <i class="fa fa-trash-o"></i>
                @T("Admin.Common.Delete")
            </span>
        </div>
    </div>
    @Html.Partial("_CreateOrUpdate", Model)
}
<nop-delete-confirmation asp-model-id="@Model.Id" asp-action="Delete" asp-button-id="promotion-delete" />
@* @Html.DeleteConfirmation("promotion-delete") *@
