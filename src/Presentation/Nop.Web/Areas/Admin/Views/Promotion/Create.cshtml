@model CustomPromotionModel

@{
    //page title
    ViewBag.Title = T("Admin.Catalog.Manufacturers.AddNew").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Promotions");
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "promotion-form" }))
{
    @Html.AntiForgeryToken()
    <div class="content-header clearfix">
        <h1 class="float-left">
            Add Price Range Discount
            <small><i class="fa fa-arrow-circle-left"></i>@Html.ActionLink("back to promotion list", "List")</small>
        </h1>
        <div class=" float-right">
            <button type="submit" name="save" class="btn btn-primary ">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary ">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.SaveContinue")
            </button>
        </div>
    </div>
    @Html.Partial("_CreateOrUpdate", Model)
}