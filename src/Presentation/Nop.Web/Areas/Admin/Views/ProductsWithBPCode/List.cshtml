@using Nop.Web.Areas.Admin.Models.CustomPage
@model ProductsWithBPCodeSearchModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Catalog.ProductsWithBPCode").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("ProductsWithBPCode");
}


<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Admin.Catalog.ProductsWithBPCode")
    </h1>
    <div class="float-right m-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-square"></i>
            @T("Admin.Common.AddNew")
        </a>  
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">                      

                       @await Html.PartialAsync("Table", new DataTablesModel
                       {
                           Name = "products-with-bpcode-grid",
                           UrlRead = new DataUrl("List", "ProductsWithBPCode", null),
                           UrlDelete = new DataUrl("Delete", "ProductsWithBPCode", null),
                           SearchButtonId = "search-products",
                           Length = Model.PageSize,
                           LengthMenu = Model.AvailablePageSizes,                       
                           ColumnCollection = new List<ColumnProperty>
                           {                                                               
                                new ColumnProperty(nameof(ProductsWithBPCodeModel.ProductName))
                                {
                                    Title = T("Admin.Catalog.Products.Fields.Name").Text,
                                     Width = "300"
                                },
                                new ColumnProperty(nameof(ProductsWithBPCodeModel.Sku))
                                {
                                    Title = T("Admin.Catalog.Products.Fields.Sku").Text,
                                    Width = "100"
                                },                                
                                new ColumnProperty(nameof(ProductsWithBPCodeModel.Email))
                                {
                                    Title = T("Admin.Customers.Customers.Fields.Email").Text,
                                    Width = "300"
                                },
                                new ColumnProperty(nameof(ProductsWithBPCodeModel.BpCode))
                                {
                                    Title = T("Admin.Customers.Customers.Fields.BPCode").Text,
                                    Width = "200"
                                },
                                new ColumnProperty(nameof(ProductModel.Id))
                                {
                                    Title = T("Admin.Common.Edit").Text,
                                    Width = "100",
                                    ClassName =  NopColumnClassDefaults.Button,
                                    Render = new RenderButtonEdit(new DataUrl("Edit"))
                                },
                                new ColumnProperty(nameof(ProductModel.Id))
                                {
                                    Title = T("Admin.Common.Delete").Text,
                                    Width = "100",
                                    ClassName =  NopColumnClassDefaults.Button,
                                    Render = new RenderButtonRemove(T("Admin.Common.Delete").Text)
                                }
                           }
                       })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>