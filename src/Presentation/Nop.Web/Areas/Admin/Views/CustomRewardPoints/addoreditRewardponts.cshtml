@model Nop.Web.Areas.Admin.Models.CustomRewardPoint.RewardsPointCustom

@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Id)

@{
    var weeks = new List<SelectListItem>
    {
        new SelectListItem { Value = "Monday", Text = "Monday" },
        new SelectListItem { Value = "Tuesday", Text = "Tuesday" },
        new SelectListItem { Value = "Wednesday", Text = "Wednesday" },
        new SelectListItem { Value = "Thursday", Text = "Thursday" },
        new SelectListItem { Value = "Friday", Text = "Friday" },
        new SelectListItem { Value = "Saturday", Text = "Saturday" },
        new SelectListItem { Value = "Sunday", Text = "Sunday" }
    };
}
@if (ViewBag.RefreshPage == true)
{
    <script type="text/javascript">
        try {
            window.opener.document.forms['@(ViewBag.formId)'].@(ViewBag.btnId).click();

        }
        catch (e) { }
        window.close();
    </script>
}
<form asp-controller="CustomRewardPoints" asp-action="addoreditRewardponts" method="post">
    <input type="hidden" id="hdnid" value="@Model.Id" />
    <div class="content-header clearfix">
        <h1 class="float-left">
            Add/Edit Reward Points Discount
            <small><i class="fa fa-arrow-circle-left"></i>@Html.ActionLink("back to  list", "CustomReward")</small>
        </h1>
        <div class=" float-right">
            <button type="submit" name="save" class="btn btn-primary ">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary ">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.SaveContinue")
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="content">
            <div class="form-horizontal">
                <div class="panel-group">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <div class="label-wrapper">
                                        <label class="control-label" for="FromRange" title="">
                                            Select Type
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-1 Categorycheck">
                                    @Html.RadioButtonFor(model => model.DDlValue, "Category", new { @id = "chkCategory", @class = "chkboxClick" })
                                    @{
                                        Html.ValidationMessageFor(model => model.DDlValue);
                                    }
                                    <label class="control-label" for="category" title="Category">
                                        Category
                                    </label>
                                </div>
                                <div class="col-md-1 Brandcheck">
                                    @Html.RadioButtonFor(model => model.DDlValue, "Designer", new { @id = "chkDesigner", @class = "chkboxClick" })
                                    @{
                                        Html.ValidationMessageFor(model => model.DDlValue);
                                    }
                                    <label class="control-label" for="designer" title="Designer">
                                        Brand
                                    </label>
                                </div>
                                <div class="col-md-1 Productcheck">
                                    @Html.RadioButtonFor(model => model.DDlValue, "Product", new { @id = "chkProduct", @class = "chkboxClick" })
                                    @{
                                        Html.ValidationMessageFor(model => model.DDlValue);
                                    }
                                    <label class="control-label" for="product" title="Product">
                                        Product
                                    </label>
                                </div>
                            </div>
                            <div class="form-group row isactive">
                                <div class="col-md-3">
                                    <div class="label-wrapper">
                                        <label class="col-form-label" for="VendorId">Reward offer from</label>
                                        <div title="" data-toggle="tooltip" class="ico-help" data-original-title="Reward offer From">
                                            <i class="fas fa-question-circle">

                                            </i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(m => m.StartWeek, weeks, new { @class = "form-control valid", @data_val = "true", @data_val_required = "The Manager of vendor field is required.", id = "StartWeek", aria_describedby = "VendorId-error", aria_invalid = "false" })
                                    <span class="field-validation-valid" data-valmsg-for="VendorId" data-valmsg-replace="true">

                                    </span>
                                </div>
                            </div>
                            <div class="form-group row isactive">
                                <div class="col-md-3">
                                    <div class="label-wrapper">
                                        <label class="col-form-label" for="VendorId">Reward offer To</label>
                                        <div title="" data-toggle="tooltip" class="ico-help" data-original-title="Reward offer To">
                                            <i class="fas fa-question-circle">

                                            </i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-9">

                                    @Html.DropDownListFor(m => m.EndWeek, weeks, new { @class = "form-control valid", @data_val = "true", @data_val_required = "The Manager of vendor field is required.", id = "EndWeek", aria_describedby = "VendorId-error", aria_invalid = "false" })
                                    <span class="field-validation-valid" data-valmsg-for="VendorId" data-valmsg-replace="true">

                                    </span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="CustomerRoleName" />
                                </div>

                                <div class="col-md-9">
                                    <div class="input-group-append input-group-required">
                                        <div class="input-group">
                                            <nop-select asp-for="CustomerRoleid" asp-items="Model.AvailableCustomerRoles" asp-multiple="true" />
                                        </div>
                                        <input type="hidden" id="hdncustomerrole" />
                                        <div class="input-group-btn">
                                            <nop-required />
                                        </div>
                                    </div>
                                    <script>
                                        $(document).ready(function () {
                                            var customerRoleIdsInput = $('#@Html.IdFor(model => model.CustomerRoleid)').data("kendoMultiSelect");
                                            customerRoleIdsInput.setOptions({
                                                customerRoleIdsInput: false,
                                                filter: "contains"
                                            });

                                        @if (Model.AvailableCustomerRoles.Count == 0)
                                        {
                                            <text>
                                                    customerRoleIdsInput.setOptions({
                                                        enable: false,
                                                        placeholder: '@T("Admin.Customers.Customers.Fields.CustomerRoles.NoRoles")'
                                                    });
                                                customerRoleIdsInput._placeholder();
                                                customerRoleIdsInput._enable();
                                            </text>
                                        }
                                                                                                                                                                                                                                                                                                                                                                            });
                                    </script>
                                </div>
                            </div>
                            <div id="category" class="form-group row" @(Model.AvailableCategories.SelectionIsNotPossible() ? Html.Raw("style=\"display:none\"") : null)>
                                <div class="col-md-3">
                                    <div class="label-wrapper">
                                        <label class="control-label" for="categoryId" title="">
                                            Select Category
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    @Html.HiddenFor(x => x.CategoryId, new { @Id = "CategoryId" })
                                    @Html.DropDownListFor(m => m.ddlCategory, Model.AvailableCategories, new { @class = "form-control ddlChangeValue" })
                                </div>
                            </div>
                            <div id="designer" class="form-group row" @(Model.AvailableCategories.SelectionIsNotPossible() ? Html.Raw("style=\"display:none\"") : null)>
                                <div class="col-md-3">
                                    <div class="label-wrapper">
                                        <label class="control-label" for="designerId" title="">
                                            Select Brand
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    @*  @Html.HiddenFor(x => x.DesignerId, new { @Id = "DesignerId" }) *@
                                    @Html.DropDownListFor(m => m.DesignerId, Model.AvailableManufacturers, new { @class = "form-control ddlChangeValue" })
                                </div>
                            </div>
                            <div id="Products" class="form-group row">
                                <div class="col-md-3">
                                    <div class="label-wrapper">
                                        <label class="control-label" for="ProductId" title="">
                                            Select Product
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    @Html.TextBoxFor(model => model.ProductIds, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                    @Html.HiddenFor(x => x.ProductIds, new { @Id = "ProductIds" })
                                    <input type="hidden" name="ProductIds" id="ProductId" value="@Model.ProductIds" />
                                    @Html.HiddenFor(x => x.ProductName, new { @Id = "hdnProductName" })
                                    @Html.ValidationMessageFor(model => model.ProductIds)
                                    <div id="productname">
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <button class="btn btn-primary" type="submit" id="btnAddProduct" onclick="javascript:OpenWindow('@(Url.Action("ProductAddPopup", "CustomRewardPoints", new { categoryId = Model.SingleProductId, btnId = "btnRefreshProducts", formId = "category-form" }))', 800, 800, true); return false;"
                                <i class="fa fa-plus-square"></i>
                                Add Product
                            </button>
                                    <button type="button" id="btnRefreshPromoProducts" style="display: none" />
                                    <script type="text/javascript">
                                        $(document).ready(function () {
                                            $('#btnRefreshPromoProducts').click(function () {
                                                return false;
                                            });
                                        });
                                    </script>
                                </div>
                            </div>



                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <div class="label-wrapper">
                                    @Html.LabelFor(model => model.RewardPoints)
                                </div>
                            </div>
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.RewardPoints)
                                @Html.ValidationMessageFor(model => model.RewardPoints)
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <div class="label-wrapper">
                                    @Html.LabelFor(model => model.Active)
                                </div>
                            </div>
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.Active)
                                @Html.ValidationMessageFor(model => model.Active)
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script type="text/javascript">
                $(document).ready(function () {
                    if ($('#hdnid').val() == 0) {
                        $('.chkboxClick').filter('[value=Category]').prop('checked', true);
                        $('#designer').hide();
                        $('#Products').hide();
                    } else {
                        $('.chkboxClick').filter('[value=@Model.DDlValue]').prop('checked', true);
                        if ("@Model.DDlValue" == "Category") {
                            $('#category').show();
                            $('#Products').hide();
                            $('#designer').hide();
                            $('#simpleProduct').hide();
                            $('.Brandcheck').hide();
                            $('.Productcheck').hide();
                            // $("#ddlCategory").val($('#CategoryId').val());
                        } else if ("@Model.DDlValue" == "Designer") {
                            $('#designer').show();
                            $('#category').hide();
                            $('#Products').hide();
                            $('.Categorycheck').hide();
                            $('.Productcheck').hide();
                            $('#simpleProduct').hide();
                            // $("#ddlDesigner").val($('#DesignerId').val());
                        } else {
                            $('#simpleProduct').show();
                            $('#category').hide();
                            $('#designer').hide();
                            $('#Products').show();
                            $('.Categorycheck').hide();
                            $('.Brandcheck').hide();
                        }
                    }
                    if ($('#quantity').is(':checked')) {
                        $(".ToRangeclass").hide();
                        $("#USD").hide();
                        $(".PriceRangeFrom").text("Add Quantity");
                    }
                    else {
                        $(".ToRangeclass").show();
                        $("#USD").show();
                        $(".PriceRangeFrom").text("Price Range From");
                    }
                    document.getElementById("productname").innerHTML = ' ';
                    var productNameParts = document.getElementById("hdnProductName").value.split('$');

                    var productNameDiv = document.getElementById("productname");
                    for (var i = 0; i < productNameParts.length; i++) {
                        productNameDiv.innerHTML += productNameParts[i] + "<br>"; // Append each part with a line break
                    }
                    document.getElementById("singleproductname").innerHTML = ' ';
                    var productNameParts = document.getElementById("hdnSingleProductName").value.split('$');

                    var productNameDiv = document.getElementById("singleproductname");
                    for (var i = 0; i < productNameParts.length; i++) {
                        productNameDiv.innerHTML += productNameParts[i] + "<br>"; // Append each part with a line break
                    }


                });

                $('.chkboxClick').change(function () {
                    var value = $(this).filter(':checked').val();
                    if (value == "Category") {
                        $('#category').show();
                        $('#designer').hide();
                        $('#Products').hide();
                        $('#simpleProduct').hide();
                        $('#designer').find('select').prop('selectedIndex', 0);
                        $("#DesignerId").val(0);
                        $("#SingleProductId").val(0);
                        $("#SingleProductName").val('');

                    }
                    else if (value == "Designer") {
                        $('#category').hide();
                        $('#designer').show();
                        $('#simpleProduct').hide();
                        $('#Products').hide();
                        $('#category').find('select').prop('selectedIndex', 0);
                        $("#CategoryId").val(0);
                        $("#SingleProductId").val(0);
                        $("#SingleProductName").val('');
                    } else {
                        $('#category').hide();
                        $('#designer').hide();
                        $('#Products').show();
                        $('#simpleProduct').show();
                        $('#category').find('select').prop('selectedIndex', 0);
                        $('#designer').find('select').prop('selectedIndex', 0);
                        $("#CategoryId").val(0);
                        $("#DesignerId").val(0);
                    }
                });

                $('.ddlChangeValue').change(function () {
                    var value = $(this).attr('id');
                    if (value == "ddlCategory") {
                        $("#CategoryId").val($(this).val());
                        $("#DesignerId").val(0);
                    } else if (value == "ddlDesigner") {
                        $("#DesignerId").val($(this).val());
                        $("#CategoryId").val(0);
                    }
                });
                $('#hdncustomerrole').change(function () {

                })
                $(".SelectedOption").click(function () {
                    if ($('#quantity').is(':checked')) {
                        $(".ToRangeclass").hide();
                        $("#USD").hide();
                        $(".PriceRangeFrom").text("Add Quantity");
                    }
                    else {
                        $(".ToRangeclass").show();
                        $("#USD").show();
                        $(".PriceRangeFrom").text("Price Range From");
                    }
                });
            </script>
        </div>
    </div>
    </div>
</form>