                    <script src="https://cdn.gtranslate.net/widgets/latest/float.js" defer></script>
                    <script>                        

                        function detectLanguageChange() {
                            
                            // The GTranslate widget creates a select element, let's listen for changes on it
                            const languageSelect = document.querySelector('.gtranslate_wrapper select');

                            if (languageSelect) {
                                languageSelect.addEventListener('change', function () {                                    
                                    var currentLang = window.location.hash.substring(1); // Get selected language from URL hash
                                    if (this.value === 'en') {
                                     
                                        deleteCookie('googtrans');
                                        //location.reload(); 
                                    }
                                });
                            } 
                        }
                        function deleteCookie(name) {
                            var domain = window.location.hostname;
                            var path = '/';

                            // Delete cookie for the current domain
                            document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=' + path + '; domain=.' + domain + ';';
                            document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=' + path + '; domain=' + domain + ';';

                            // If domain is a subdomain, also attempt to delete the cookie for the parent domain
                            var parentDomain = domain.startsWith('www.') ? domain.substring(4) : domain;
                            if (parentDomain !== domain) {
                                document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=' + path + '; domain=.' + parentDomain + ';';
                                document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=' + path + '; domain=' + parentDomain + ';';
                            }

                            // Finally, delete the cookie without any domain specification (browser default)
                            document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=' + path + ';';
                            location.reload();
                        }

                        // Run the language change detection after the widget is loaded
                        window.addEventListener('load', function () {
                            
                            detectLanguageChange();
                        });
                   
                    </script>
