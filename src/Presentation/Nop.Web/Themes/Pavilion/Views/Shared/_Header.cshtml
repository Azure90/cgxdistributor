            <script>
                function setCookie(cookieName, cookieValue, daysToExpire) {
                    const expirationDate = new Date();
                    expirationDate.setDate(expirationDate.getDate() + daysToExpire);

                    const cookieString = `${cookieName}=${encodeURIComponent(cookieValue)}; expires=${expirationDate.toUTCString()}; path=/`;
                    document.cookie = cookieString;
                }
                function getCookie(cookieName) {
                    const name = cookieName + "=";
                    const decodedCookie = decodeURIComponent(document.cookie);
                    const cookieArray = decodedCookie.split(';');

                    for (let i = 0; i < cookieArray.length; i++) {
                        let cookie = cookieArray[i].trim();
                        if (cookie.indexOf(name) == 0) {
                            return cookie.substring(name.length, cookie.length);
                        }
                    }
                    return null;
                }

                $(".close").click(function () {
                    $("#myModal").hide();
                });
                function redirectToPage() {
                    if ($(".Associated").val() != 0) {
                        var selectedvalue = $(".option_" + $(".Associated").val()).attr("data-isactive");
                        if (selectedvalue == "True") {

                            $.ajax({
                                type: 'GET',
                                url: '/Customer/finishImpersonate',
                                success: function (data) {
                                    var associateid = $(".Associated").val();
                                    setCookie('ImpersonateCustomer', 'Impersonate');
                                    setCookie('ImpersonateCustomerid', associateid);

                                    //sessionStorage.setItem('ImpersonateCustomer', 'Impersonate');

                                    window.location.href = '/Customer/Impersonate?id=' + associateid;
                                }
                            })
                        }
                        else {
                            $("#myModal").show();
                            $("#myModal p").text("This Customer is not Active.Please select another Customer!").css("color", "red");
                            $(".Associated").val(0);

                        }
                    }
                }



                // document.getElementById('Associated').addEventListener('change', function () {
                //     var associateid = $(".Associated").val();
                //     window.location.href = '/Customer/Impersonate?id=' + associateid;
                // });
            </script>

