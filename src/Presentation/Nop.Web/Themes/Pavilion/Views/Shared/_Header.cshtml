                        for (var i = 0; i < data.length; i++) {
                            
                            //let svgIconCheck = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="20" height="20"><path d="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z"/></svg>';
                            var iconClass = data[i].Active == "True" ? "customer-active" : "customer-inactive";
                            var addclass = "option_" + data[i].Id + " " + iconClass;
                            var associatecustomer1 = "<option data-isactive='" + data[i].Active + "' class='" + addclass + "' value='" + data[i].Id + "'>" + data[i].DisplayName + "</option>";



                            $(".Associated").append(associatecustomer1);
                        }
                        const bannerValue = getCookie('ImpersonateCustomerid');
                        var aa = parseInt(bannerValue);
                        if (aa > 0) {
                            $(".Associated").val(aa);
                        }
                    }
                }
            })
        }



        $(".close").click(function () {
            $("#myModal").hide();

        });
        $.ajax({
            type: 'GET',
            url: '/Customer/CheckImprotedCustomer',
            success: function (data) {
                if (data != 0) {
                    $("#myModal").show();
                    $("#modalBody").html(data);
                    //$("#myModal p").html(data);
                }
            }
        })


        $.ajax({
            type: 'Post',
            url: '/Customer/customerrole',

            success: function (data) {
                var obj = "usd";

                if (data == "USD B2C") {
                    obj = "usd"
                }
                else if (data == "CAD B2C") {
                    obj = "cad"
                }
                else if (data == "USD B2B INTL") {
                    obj = "intl"
                }
                $(".selectroles").val(obj);

            }
        })
    });
    function previousorder() {
        $("#hdnprevoiusorder").val("fromheader");
        if ($("#hdnstatus").val() == "") {
            $.ajax({
                url: '/Common/GetPreviousOrderProduct',
                type: 'get',
                success: function (data) {
                    $("#render").html(data.innerhtml);

                },
            });
            return false;
        }
        else {
            $("#hdnstatus").val("");
            return true;
        }

    }
