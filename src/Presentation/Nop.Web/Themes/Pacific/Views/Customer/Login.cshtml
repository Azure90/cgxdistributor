@model LoginModel
@using Nop.Core
@using Nop.Core.Domain.Customers
@inject IWebHelper webHelper

@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(T("PageTitle.Login").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-login-page");

    //register URL with return URL (if specified)
    var registerUrl = Url.RouteUrl("Register", new { returnUrl = this.Context.Request.Query["returnUrl"] }, webHelper.GetCurrentRequestProtocol());
}
<link href="~/css/custompage/pacificthemecss/pacificcss.css" rel="stylesheet" />

<div class="page login-page">
    <div class="page-title">
        <h1>@T("Account.Login.Welcome")</h1>
    </div>
    @await Html.PartialAsync("_ExternalAuthentication.Errors")
    <div class="page-body">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LoginTop, additionalData = Model })
        <div class="login-tabs">
            <ul class="login-tabs-header">
                <li>
                    <a href="#returningCustomer" class="login-tabs-title login">
                        <strong>@T("Account.Login.ReturningCustomer")</strong>
                    </a>
                </li>
                <li>
                    <a href="#registerBlock" class="login-tabs-title register">
                        @if (Model.CheckoutAsGuest)
                        {
                            <strong>@T("Account.Login.CheckoutAsGuestOrRegister")</strong>
                        }
                        else
                        {
                            <strong>@T("Account.Login.NewCustomer")</strong>
                        }
                    </a>
                </li>
            </ul>
            <div class="login-tabs-body">
                <div id="returningCustomer" class="login-tabs-block">
                     <div class="returning-wrapper fieldset">
                        <form asp-route="Login" asp-route-returnurl="@Context.Request.Query["ReturnUrl"]" method="post" autocomplete="off">
                            <div asp-validation-summary="ModelOnly" class="message-error">@T("Account.Login.Unsuccessful")</div>
                            <div class="form-fields">
                                @if (Model.UsernamesEnabled)
                                {
                                    <div class="inputs login-field username">
                                        <input asp-for="Username" class="username" placeholder="@T("Account.Login.Fields.Username")" autofocus="autofocus" />
                                        <span asp-validation-for="Username"></span>
                                    </div>
                                }
                                else
                                {
                                    <div class="inputs login-field email">
                                        <input asp-for="Email" class="email" placeholder="@T("Account.Login.Fields.Email")" autofocus="autofocus" />
                                        <span asp-validation-for="Email"></span>
                                    </div>
                                }
                                <div class="inputs login-field password">
                                    <input asp-for="Password"  placeholder="@T("Account.Login.Fields.Password")"  class="password" />
                                    <span asp-validation-for="Password"></span>
                                </div>
                                <div class="inputs">
                                    <div id="twofainput"></div>
                                    <span id="Emptytext"></span>
                                </div>
                                <div class="inputs reversed">
                                    <input asp-for="RememberMe" />
                                    <label asp-for="RememberMe"></label>
                                    <span class="forgot-password">
                                        <a asp-route="PasswordRecovery">@T("Account.Login.ForgotPassword")</a>
                                    </span>
                                </div>
                                @if (Model.DisplayCaptcha)
                                {
                                	<nop-captcha />
                                }
                            </div>
                            <input type="hidden" id="hdnisauthenticated" value="@ViewBag.Isauthenticated" />
                            <div class="buttons">
                                <button type="submit" onclick="return checkcustomer()" class="button-1 login-button">@T("Account.Login.LoginButton")</button>
                            </div>
                            <input type="hidden" id="hdntwofa" />
                            <input type="hidden" id="hdnisvalid" />
                            <input type="hidden" id="hdntimer" />
                        </form>
                    </div>
                </div>
                <div id="registerBlock" class="login-tabs-block">
                    @if (Model.CheckoutAsGuest)
                    {
                        <div class="new-wrapper checkout-as-guest-or-register-block">
                            <div class="text">
                                @await Component.InvokeAsync(typeof(TopicBlockViewComponent), new { systemName = "CheckoutAsGuestOrRegister" })
                            </div>
                            <div class="buttons">
                                <button type="button" class="button-1 checkout-as-guest-button" onclick="location.href='@Url.RouteUrl("Checkout")'">@T("Account.Login.CheckoutAsGuest")</button>
                                <button type="button" class="button-1 register-button" onclick="location.href='@registerUrl'">@T("Account.Register")</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="new-wrapper register-block">
                            <div class="text">
                                @T("Account.Login.NewCustomerText")
                            </div>
                            <div class="buttons">
                                <button type="button" class="button-1 register-button" onclick="location.href='@registerUrl'">@T("Account.Register")</button>
                            </div>
                        </div>

                       @*  <div id="DistributorContactUs">


                        </div>
                        <form id="contactform">
                            <div asp-validation-summary="ModelOnly" class="message-error"></div>
                            <div class="fieldset">
                                <div class="form-fields">
                                    <div class="inputs">
                                        <label asp-for="FullName" asp-postfix=":"></label>
                                        <input asp-for="FullName" placeholder="@T("ContactUs.FullName.Hint")" class="fullname" />

                                        <span asp-validation-for="FullName"></span>
                                    </div>
                                    <div class="inputs">
                                        <label asp-for="Email" asp-postfix=":"></label>
                                        <input asp-for="Email" placeholder="@T("ContactUs.Email.Hint")" class="email" />
                                        <nop-required />
                                        <span asp-validation-for="Email"></span>
                                    </div>

                                    <div class="inputs">
                                        <label asp-for="Subject" asp-postfix=":"></label>
                                        <input asp-for="Subject" placeholder="@T("ContactUs.Subject.Hint")" class="subject" />
                                        <nop-required />
                                        <span asp-validation-for="Subject"></span>
                                    </div>
                                    <div class="inputs">
                                        <label asp-for="country" asp-postfix=":"></label>
                                        <select asp-for="country" asp-items="Model.countrylist"
                                                data-trigger="country-select"
                                                data-url="@(Url.RouteUrl("GetStatesByCountryId"))"
                                                data-loading="#states-loading-progress"></select>
                                    </div>

                                    <div class="inputs">
                                        <label asp-for="Enquiry" asp-postfix=":"></label>
                                        <textarea asp-for="Enquiry" placeholder="@T("ContactUs.Enquiry.Hint")" class="enquiry"></textarea>
                                        <nop-required />
                                        <span asp-validation-for="Enquiry"></span>
                                    </div>
                                    @if (Model.DisplayCaptcha)
                                    {
                                        <nop-captcha />
                                    }
                                </div>
                            </div>
                            <span id="allfield"></span>
                            <div class="buttons">
                                <button type="button" name="send-email" class="button-1 contact-us-button" id="btncontact" >@T("ContactUs.Button")</button>
                            </div>
                        </form> *@
                    }
                    <div id="success"></div>
                </div>
            </div>
        </div>
        @await Component.InvokeAsync(typeof(ExternalMethodsViewComponent), "ExternalAuthentication")
        @await Component.InvokeAsync(typeof(TopicBlockViewComponent), new { systemName = "LoginRegistrationInfo" })
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LoginBottom, additionalData = Model })
    </div>
</div>
<script>
    
    $("#btncontact").click(function () {
        $.ajax({
            type: 'Get',
            url: '/DistributorPortal/ContactUsdetail',
            data: {
                FullName: $('#FullName').val(),
                Email: $('#Email').val(),
                Subject: $('#Subject').val(),
                country: $('#country').val(),
                Enquiry: $('#Enquiry').val()
            },
            success: function (data) {
                debugger
                if (data.Result == true) {
                    $("#contactform").hide();
                    $("#success").text("Mail Sent!").css("color", "green");
                }
            }
        })
    })
    
   

    function checkcustomer() {
        debugger
        if ('@ViewBag.Isauthenticated' == 'true') {
            debugger
            if ($('#hdnisvalid').val() != "hdnisvalid") {
                if ($('#hdntimer').val() != "hdntimer") {

                    if ($('#facode').val() == undefined || $("#facode").attr("data-facode") == 'getfacode') {
                        if ($('#facode').val() != "") {


                            $.ajax({
                                url: '/Customer/Loginwithcode',
                                type: 'GET', // or 'POST' depending on your requirements
                                data: { model: $('#Loginformid').serialize(), visit: $('#hdntwofa').val(), uniquecode: $('#facode').val(), ToEMail: $('#Email').val(), Pasword: $('#Password').val() },
                                success: function (data) {
                                    debugger
                                    if (data.result == 0) {
                                        $('#twofainput').html('');
                                        $('#hdntwofa').val('first');
                                        var appendinput = "";
                                        appendinput += '<label>Verification Code:</label>'
                                        appendinput += '<input id="facode" type="Password" data-facode="getfacode"/>'
                                        $('#twofainput').append(appendinput);
                                        $("#Emptytext").text("Please Enter the Code sent on your given Mail !").css("color", "green")
                                    }
                                    else if (data.result == 2) {
                                        $("#Emptytext").text("Your Entered code is not correct !").css("color", "red");
                                    }
                                    else if (data.result == 1) {
                                        $("#hdnisvalid").val("hdnisvalid");
                                        $(".login-button").click();


                                    }
                                    else if (data.result == 3) {
                                        $("#hdntimer").val("hdntimer");
                                        $(".login-button").click();


                                    }
                                    else if (data.result == 4) {
                                        $("#Emptytext").text("Entered Username and password not correct!").css("color", "red");


                                    }
                                },

                            });
                        }
                        else {
                            $("#Emptytext").text("Please Enter the Code!").css("color", "red");
                        }
                    }
                    else {
                        $("#Emptytext").text("Please Enter the Code!").css("color", "red");
                    }

                    return false;
                }
                else {
                    return true;
                }
            }
            else {
                return true;
            }
        }
        else {
            return true;
        }
    }
</script>