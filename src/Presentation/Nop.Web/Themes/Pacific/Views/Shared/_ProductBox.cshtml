    </div>
    <div class="details">
        <div class="details-top">
            <h2 class="product-title">
                <a href="@(Url.RouteUrl<Product>(new {SeName = Model.SeName }))">@Model.Name</a>
            </h2>
            @if (Model.ReviewOverviewModel.AllowCustomerReviews)
            {
                var ratingPercent = 0;
                if (Model.ReviewOverviewModel.TotalReviews != 0)
                {
                    ratingPercent = ((Model.ReviewOverviewModel.RatingSum * 100) / Model.ReviewOverviewModel.TotalReviews) / 5;
                }
                <div class="product-rating-box" title="@string.Format(T("Reviews.TotalReviews").Text, Model.ReviewOverviewModel.TotalReviews)">
                    <div class="rating">
                        <div style="width: @(ratingPercent)%">
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (catalogSettings.ShowSkuOnCatalogPages && !string.IsNullOrEmpty(Model.Sku))
        {
            <div class="sku">
                @Model.Sku
            </div>
        }

        <div class="description" @(catalogSettings.ShowShortDescriptionOnCatalogPages ? "" : "data-short-description=none")>
            @Html.Raw(Model.ShortDescription)
        </div>

        <div class="prices">
            @{
                var isPriceDiscounted = "only-price";
                if (!string.IsNullOrEmpty(Model.ProductPrice.OldPrice))
                {
                    isPriceDiscounted = "actual-price";
                }
            }
            @if (workContext.GetCurrentCustomerAsync().Result.Email != null || T("Product.Price.LoginForPrice").Text == "product.price.loginforprice")
            {
                // <span class="price @isPriceDiscounted">@Model.ProductPrice.Price</span> 

                @********** Commented by tpss sh for exclusive discount  *******@
                @* @if (Model.IsSample == true) *@
                @if (!Model.DiscountOrSpecialApplied)
                {
                    <span class="price @isPriceDiscounted">
                        @ProductPrice
                    </span>
                    @* <span class="price actual-price finalprice" data-productmodelprice="@Model.ProductPrice.Price" data-productlowprice="@checkprice" data-productid="@Model.Id">@ProductPrice</span> *@
                }

                @if (!string.IsNullOrEmpty(Model.ProductPrice.OldPrice))
                {
                    <span class="price old-price">@Model.ProductPrice.OldPrice</span>
                }
                @if (Model.ProductPrice.DisplayTaxShippingInfo)
                {
                    var inclTax = await workContext.GetTaxDisplayTypeAsync() == TaxDisplayType.IncludingTax;
                    //tax info is already included in the price (incl/excl tax). that's why we display only shipping info here
                    //of course, you can modify appropriate locales to include VAT info there
                    <span class="tax-shipping-info">
                        @T(inclTax ? "Products.Price.TaxShipping.InclTax" : "Products.Price.TaxShipping.ExclTax", Url.RouteTopicUrl("shippinginfo"))
                    </span>
                }
                @if (!string.IsNullOrEmpty(Model.ProductPrice.BasePricePAngV))
                {
                    <div class="base-price-pangv">
                        @Model.ProductPrice.BasePricePAngV
                    </div>
                }

            }
            else
            {
                @if (currRoles != null)
                {
                    @if (currRoles.Name != "USD B2B INTL")
                    {
                        <span class="price actual-price" data-productmodelprice="@Model.ProductPrice.Price" data-productlowprice="@checkprice"><a href="login/?returnUrl=@Context.Request.GetEncodedPathAndQuery()">@T("Product.Price.LoginForPrice")</a></span>

                    }
                    else
                    {

                        <span class="price actual-price" data-productmodelprice="@Model.ProductPrice.Price" data-productlowprice="@checkprice"><a href="/contactus">Contact for Price</a></span>

                    }
                }
            }
        </div>
        <div class="add-info">
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoBefore, additionalData = Model })
            <div class="buttons">
                @if (!Model.ProductPrice.DisableBuyButton)
                {
                    var addToCartText = T("ShoppingCart.AddToCart").Text;
                    if (Model.ProductPrice.IsRental)
                    {
                        addToCartText = T("ShoppingCart.Rent").Text;
                    }
                    if (Model.ProductPrice.AvailableForPreOrder)
                    {
                        addToCartText = T("ShoppingCart.PreOrder").Text;
                    }
                    if (isCartButtonDisabled)
                    {
                        addToCartText = T("ShoppingCart.InformationButton").Text;
                    }
                    @* <button type="button" class="button-2 product-box-add-to-cart-button GetpageRediect" onclick="AjaxCart.addproducttocart_catalog('@addtocartlink');return false;">@(addToCartText)</button> *@

                    @********** Commented by tpss sh for exclusive discount  *******@
                    @if (!Model.DiscountOrSpecialApplied)
                    {
                        @*  <button type="button" data-productid="@Model.Id" class="button-2 product-box-add-to-cart-button GetpageRediect">Add To Cart</button> *@

                       <button type="button" data-productid="@Model.Id" class="button-2 product-box-add-to-cart-button GetpageRediect">@(addToCartText)</button>
                    }
                    else
                    {
                        <button type="button" data-productid="@Model.Id" class="button-2 product-box-add-to-cart-button GetpageRediect">More Information</button>
                   }
                }
                @if (!Model.ProductPrice.DisableWishlistButton)
                {
                    @* <button data-productid="@Model.Id" type="button" class="button-2 add-to-wishlist-button "  title="@T("ShoppingCart.AddToWishlist")" onclick="AjaxCart.addproducttocart_catalog('@addtowishlistlink');return false;">@T("ShoppingCart.AddToWishlist")</button> *@
                }
                @if (!Model.ProductPrice.DisableAddToCompareListButton)
                {
                    @* <button data-productid="@Model.Id" type="button" class="button-2 add-to-compare-list-button GetpageRediect" title="@T("ShoppingCart.AddToCompareList")"  onclick="AjaxCart.addproducttocomparelist('@addtocomparelink');return false;" >@T("ShoppingCart.AddToCompareList")</button> *@
                }
            </div>

            @********** Commented by tpss sh for exclusive discount  *******@
           @* @if (Model.IsSample == true) 
            {
                <a id="btnaddtocart_@Model.Id" class="item-box-overlay" href="@(Url.RouteUrl<Product>(new {SeName = Model.SeName }))" title="@Model.Name">
                    <span class="item-box-overlay-tint"></span>
                </a>
            }
            else
            {
                <a id="btnaddtocart_@Model.Id" class="item-box-overlay" href="@Url.Action("ProductDetailPage", "DistributorPortal", new { pid = Model.Id,s=true, a="0"})" title="@Model.Name">
                    <span class="item-box-overlay-tint"></span>
                </a> 
            } *@

            @* Added by tpss sh  *@
            @if (!Model.DiscountOrSpecialApplied)
            {
                <a id="btnaddtocart_@Model.Id" class="item-box-overlay" href="@(Url.RouteUrl<Product>(new {SeName = Model.SeName }))" title="@Model.Name">
                    <span class="item-box-overlay-tint"></span>
                </a>
            }
            else
            {
                <a id="btnaddtocart_@Model.Id" class="item-box-overlay" href="@Url.Action("ProductDetailPage", "DistributorPortal", new { pid = Model.Id,s=true, a="0"})" title="@Model.Name">
                    <span class="item-box-overlay-tint"></span>
                </a> 
            }

            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoAfter, additionalData = Model })
        </div>
        <div class="attribute-squares-wrapper"></div>
    </div>
</div>
