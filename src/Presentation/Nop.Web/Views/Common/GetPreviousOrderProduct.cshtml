                    </div>
                </div>
            } *@

        }
        else
        {
            <h3>@T("Common.GetPreviousOrder")</h3>
        }
        <div class="row">
            <div id="diamondText" class="productContainer" style="display:none;"></div>
        </div>

        

    </div>
    <input type="button" id="continue-button" style="background: #a3da40;" class="continueButton" value="CONTINUE">
</div>

<div id="overlay"></div>





<script>

    $(document).ready(function () {
        if ($("#hdnprevoiusorder").val() == "fromheader") {
            $("#continue-button").css("display", "none");
        }
        const closeSidebarButton = document.getElementById('closeSidebar');
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        sidebar.style.right = '0';
        overlay.style.display = 'block';
        closeSidebarButton.addEventListener('click', (e) => {
            sidebar.style.right = '-100%';
            overlay.style.display = 'none';
            e.preventDefault();
        });
    });

    $(document).on("click", ".GetpageRediect", function () {
        var proid = $(this).attr("data-productid");
        var Productdetail = $("#btnaddtocart_" + proid).attr("href");

        window.location.href = Productdetail;
    });
    $("#continue-button").click(function () {
        $("#hdnstatus").val("true");
        $("#checkout").click();
    });
    $("#closeSidebar").click(function () {
        $("#hdnprevoiusorder").val("");
    });
    // Call the function to set the cookie

</script>