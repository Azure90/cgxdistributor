                                    <div class="rating">
                                        <div style="width: 0%">
                                        </div>
                                    </div>
                                </div>
                            </div>



                            <div class="prices" style="height: 17px;">
                                <span class="price only-price" data-productid="@item.ProductId"> @item.Price</span>
                            </div>
                            <div class="add-info">


                                <div class="buttons">
                                    <div class="ajax-cart-button-wrapper qty-enabled" ata-productid="@item.ProductId" data-isproductpage="false">

                                        <button type="button" class="button-2 product-box-add-to-cart-button nopAjaxCartProductListAddToCartButton" data-productid="@item.ProductId">
                                            Add to cart
                                        </button>


                                    </div>

                                </div>
                                <a class="item-box-overlay" href="/foloy-business-sport" title="Show details for Foloy Business Sport (Grouped)">
                                    <span class="item-box-overlay-tint"></span>
