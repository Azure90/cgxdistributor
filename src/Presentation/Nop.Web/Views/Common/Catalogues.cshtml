@await Component.InvokeAsync("TopicBlock", new { systemName = "Catalogues" })
@await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.ContactUsTop })

<style>
    .master-wrapper-page {
        background-color: white;
    }
</style>
@if (ViewBag.successmessage == "Success")
{
    <span style="
   font-weight: 700;
    margin: 25px;
    margin: 86px 452px;
    padding: 13px 57px;
    border-radius: -27px 20px 12px 17px;
    width: 640px;
    color: #270;
    background-color: #DFF2BF;
">Mail Sent Successfully!!</span>
}
else
{
    <div class="custom-catalouges custom-supportpage">
        <form asp-route="Catalogues" method="post">
            <div class="email">
                <label> @T("Catalogues.Email.Hint")</label>
                <input id="email" name="email" data_spnid="spnemail" required="" placeholder="" type="email" class="hs-input invalid error validation" inputmode="email" autocomplete="email" value="">
                <span id="spnemail" class="custom-validation"></span>
            </div>
            <div class="custom-name">
                <div class="firstname">
                    <label> @T("Catalogues.Doctor'sFirstName.Hint")</label>
                    <input id="firstname" name="firstname" data_spnid="spnfirstname" required="" placeholder="" type="text" class="hs-input invalid error validation" inputmode="text" autocomplete="given-name" value="">
                    <span id="spnfirstname" class="custom-validation"></span>
                </div>
                <div class="lastname">
                    <label> @T("Catalogues.Doctor'sLastName.Hint")</label>
                    <input id="lastname" name="lastname" data_spnid="spnlastname" required="" placeholder="" type="text" class="hs-input invalid error validation" inputmode="text" autocomplete="family-name" value="">
                    <span id="spnlastname" class="custom-validation"></span>
                </div>
            </div>
            <div class="clinic_name">
                <label>@T("Catalogues.Practice/Clinicname.Hint")</label>
                <input id="clinic_name" name="clinic_name" data_spnid="spnClinic" required="" placeholder="" type="text" class="hs-input invalid error validation" inputmode="text" value="">
                <span id="spnClinic" class="custom-validation"></span>
            </div>
            <div class="address">
                <label> @T("Catalogues.Streetaddress.Hint")</label>
                <input id="address" name="address" data_spnid="spnaddress" required="" placeholder="" type="text" class="hs-input invalid error validation" inputmode="text" autocomplete="street-address" value="">

                <span id="spnaddress" class="custom-validation"></span>
            </div>
            <div class="custom-region">
                <div class="city">
                    <label> @T("Catalogues.City.Hint")</label>
                    <input id="city" name="city" data_spnid="spncity" required="" placeholder="" type="text" class="hs-input validation" inputmode="text" autocomplete="address-level2" value="">
                    <span id="spncity" class="custom-validation"></span>
                </div>

                <div class="State">
                    <label>@T("Catalogues.State/Region.Hint")</label>
                    <select id="state" required="" data_spnid="spnState" class="hs-input invalid error is-placeholder validation" name="state">
                        <option selected value="">@T("Support.select.Hint")</option>
                        <option value="AB">Alberta</option>
                        <option value="BC">British Columbia</option>
                        <option value="MB">Manitoba</option>
                        <option value="NB">New Brunswick</option>
                        <option value="NL">Newfoundland and Labrador</option>
                        <option value="NT">Northwest Territories</option>
                        <option value="NS">Nova Scotia</option>
                        <option value="NU">Nunavut</option>
                        <option value="ON">Ontario</option>
                        <option value="PE">Prince Edward Island</option>
                        <option value="QC">Quebec</option>
                        <option value="SK">Saskatchewan</option>
                        <option value="YT">Yukon</option>
                        <option value="AL">Alabama</option>
                        <option value="AK">Alaska</option>
                        <option value="AZ">Arizona</option>
                        <option value="AR">Arkansas</option>
                        <option value="CA">California</option>
                        <option value="CO">Colorado</option>
                        <option value="CT">Connecticut</option>
                        <option value="DE">Delaware</option>
                        <option value="FL">Florida</option>
                        <option value="GA">Georgia</option>
                        <option value="HI">Hawaii</option>
                        <option value="ID">Idaho</option>
                        <option value="IL">Illinois</option>
                        <option value="IN">Indiana</option>
                        <option value="IA">Iowa</option>
                        <option value="KC">Kansas</option>
                        <option value="KY">Kentucky</option>
                        <option value="LA">Louisiana</option>
                        <option value="ME">Maine</option>
                        <option value="MD">Maryland</option>
                        <option value="MA">Massachusetts</option>
                        <option value="MI">Michigan</option>
                        <option value="MN">Minnesota</option>
                        <option value="MS">Mississippi</option>
                        <option value="MO">Missouri</option>
                        <option value="MT">Montana</option>
                        <option value="NE">Nebraska</option>
                        <option value="NV">Nevada</option>
                        <option value="NH">New Hampshire</option>
                        <option value="NJ">New Jersey</option>
                        <option value="NM">New Mexico</option>
                        <option value="NY">New York</option>
                        <option value="NC">North Carolina</option>
                        <option value="ND">North Dakota</option>
                        <option value="OH">Ohio</option>
                        <option value="OK">Oklahoma</option>
                        <option value="OR">Oregon</option>
                        <option value="PA">Pennsylvania</option>
                        <option value="PR">Puerto Rico</option>
                        <option value="RI">Rhode Island</option>
                        <option value="SC">South Carolina</option>
                        <option value="SD">South Dakota</option>
                        <option value="TN">Tennessee</option>
                        <option value="TX">Texas</option>
                        <option value="UT">Utah</option>
                        <option value="VT">Vermont</option>
                        <option value="VA">Virginia</option>
                        <option value="WA">Washington</option>
                        <option value="WV">West Virginia</option>
                        <option value="WI">Wisconsin</option>
                        <option value="WY">Wyoming</option>
                    </select>
                    <span id="spnState" class="custom-validation"></span>
                </div>

                <div class="Postal">
                    <label>@T("Catalogues.Postalcode.Hint")</label>
                    <input id="zip" name="zip" data_spnid="spnPostal" placeholder="" type="text" class="hs-input " inputmode="text" value="">
                    <span id="spnPostal" class="custom-validation"></span>
                </div>
            </div>
            <div class="custom-Practice">
                <div class="Country">
                    <label>@T("Catalogues.Country/Region.Hint")</label>
                    <select id="country" data_spnid="spnCountry" required="" class="hs-input invalid error is-placeholder validation" name="country">
                        <option selected value="">@T("Support.select.Hint")</option>
                        <option value="Asia/Pacific Region">Asia/Pacific Region</option>
                        <option value="Australia">Australia</option>
                        <option value="Canada">Canada</option>
                        <option value="Europe">Europe</option>
                        <option value="United States">United States</option>
                        <option value="Africa">Africa</option>
                        <option value="South America">South America</option>
                    </select>
                    <span id="spnCountry" class="custom-validation"></span>
                </div>

                <div class="Practicenumber">
                    <label> @T("Catalogues.Practice/ClinicPhonenumber.Hint")</label>
                    <input id="phone" name="phone" data_spnid="spnPhone" required="" placeholder="" type="tel" class="hs-input invalid error validation" inputmode="tel" autocomplete="tel" value="">
                    <span id="spnPhone" class="custom-validation"></span>
                </div>

            </div>
            <div class="Practiceemail">
                <label>@T("Catalogues.Practice/Clinicmainemail.Hint")</label>
                <legend class="hs-field-desc" style="display: block;">@T("Catalogues.differentfromemail.Hint")</legend>
                <input id="work_email" data_spnid="spnClinicemail" name="work_email" placeholder="" type="text" class="hs-input " inputmode="text" value="">
                <span id="spnClinicemail" class="custom-validation"></span>
            </div>
            <fieldset class="form-columns-1">
                <div class="hs_catalogue_request hs-catalogue_request hs-fieldtype-checkbox field hs-form-field">

                    <label id="label-catalogue_request" class="" placeholder="@T("Catalogues.selectthecatalog(s).Hint")" for="catalogue_request">
                        <span>@T("Catalogues.catalog(s).Hint")</span>
                        <span class="hs-form-required"></span>
                    </label>
                    <div class="input">
                        <ul required="" role="checkbox" class="inputs-list multi-container">
                            <li class="hs-form-checkbox" role="checkbox">
                                <label for="catalogue_request0" class="hs-form-checkbox-display">
                                    <input id="catalogue_request0" data_spnid="spnRegeneration" class="hs-input Speciality validation" type="checkbox" name="catalogue_request " value="Regeneration products catalog">
                                    <span>@T("Catalogues.Regenerationproducts.Hint")</span>
                                </label>
                            </li>
                            <li class="hs-form-checkbox" role="checkbox">
                                <label for="catalogue_request1" class="hs-form-checkbox-display">
                                    <input id="catalogue_request1" data_spnid="spnRegeneration" class="hs-input Speciality validation" type="checkbox" name="catalogue_request" value="Surgical instruments catalog">
                                    <span>@T("Catalogues.Surgicalinstruments.Hint")</span>
                                </label>
                            </li>
                        </ul>
                        <span id="spnRegeneration" class="custom-validation"></span>
                    </div>
                </div>
            </fieldset>
            <div class="language">
                <label> @T("Support.Preferredlanguage.Hint") <span id="Preferred" class="custom-validation"></span></label>
                <select id="hs_language" data_spnid="spnPreferred" class="hs-input is-placeholder " name="hs_language">
                    <option selected value="">@T("Support.select.Hint")</option>
                    <option value="en">@T("Support.English.Hint")</option>
                    <option value="fr">@T("Support.French.Hint")</option>
                </select>
                <span id="spnPreferred" class="custom-validation"></span>
            </div>
            <span id="allfield"></span>
            <div class="actions"><input type="submit" onclick="return save()" class="hs-button primary large" value="@T("Support.Submit.Hint")"></div>
        </form>
    </div>
}
@* <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.1/jquery.min.js" integrity="sha512-aVKKRRi/Q/YV+4mjoKBsE4x3H+BkegoM/em46NNlCqNTmUYADjBbeNefNxYV7giUp0VxICtqdrbqU7iVaeZNXA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script> *@
<script>
    function save() {
        var status = false;
        debugger
        $(".validation").each(function() {
            debugger
            if ($(this).val() == "" || $(this).val() == null || $(this).val() == "Select" || ($(this).attr('type') == 'checkbox' && !$('.Speciality').is(':checked'))) {
                // $('.btnuser').attr('disabled', true)
                $(this).css({ 'border': '1px solid red' });
                $("#allfield").text("@T("Support.allrequiredfields.Hint")").css("color", "red");
                status = false;
            }
            else {
                // $('.btnuser').attr('disabled', false)
                if ($("#Email").val() == "testing@example.com" || $("#Email").val() == "sample@email.tst") {


                    location.reload();
                    status = false;
                }
                else {
                    $(this).css({ 'border': '1px solid black' });
                    status = true;
                }
            }
        });
        return status;
    }

    $(".validation").blur(function() {
        debugger
        var spnid = $(this).attr("data_spnid");
        if ($(this).val() == "" || $(this).val() == null || $(this).val() == 0 || $(this).val() == "Select" || ($(this).attr('type') == 'checkbox' && !$('.Speciality').is(':checked'))) {
            $(this).css({ 'border': '1px solid red' });
            debugger
            $("#" + spnid).text("@T("Support.thisrequiredfields.Hint")").css("color", "red")

        }
        else {

            $(this).css({ 'border': '1px solid black' });
            $("#" + spnid).text("").css("color", "red")
        }
    })
</script>