                        <option value="">@T("Support.select.Hint")</option>
                        <option value="@T("newaccount.Onaccount.Hint")">@T("newaccount.Onaccount.Hint")</option>
                        <option value="@T("newaccount.Creditcard.Hint")">@T("newaccount.Creditcard.Hint")</option>
                    </select>
                </div>
                <span id="spnpreferred_payment_option" class="custom-validation"></span>
            </div>
            <div class="hs_hs_language hs-hs_language hs-fieldtype-select field hs-form-field">
                <label id="label-hs_language" class="" placeholder="Enter your Preferred language of communication" for="hs_language">
                    <span>@T("Support.Preferredlanguage.Hint")</span><span class="hs-form-required"></span>
                </label>
                <legend class="hs-field-desc" style="display: none;"></legend><div class="input">
                    <select id="hs_language" data_spnid="spnhs_language" required="" class="hs-input is-placeholder validation" name="hs_language">
                        <option value="">@T("Support.select.Hint")</option>
                        <option value="en">@T("Support.English.Hint")</option>
                        <option value="fr">@T("Support.French.Hint")</option>
                    </select>
                </div>
                <span id="spnhs_language" class="custom-validation"></span>
            </div>
        </fieldset>
        <fieldset class="form-columns-1">
            <div class="hs_internal_account_comments hs-internal_account_comments hs-fieldtype-textarea field hs-form-field">
                <label id="label-internal_account_comments" class="" placeholder="Enter your Comments &amp;amp; identification" for="internal_account_comments">
                    <span>@T("newaccount.amp;identification.Hint")</span><span class="hs-form-required"></span>
                </label>
                <legend class="hs-field-desc" style="display: block;">@T("newaccount.IDENTIFYYOURSELFbyname.Hint")</legend>
                <div class="input">
                    <textarea id="internal_account_comments" data_spnid="spninternal_account_comments" class="hs-input validation" name="internal_account_comments" required="" placeholder="@T("newaccount.DON'TFORGETTOIDENTIFY.Hint")">

                    </textarea>
                </div>
                <span id="spninternal_account_comments" class="custom-validation"></span>
            </div>
            <span id="allfield"></span>


        </fieldset>

        <div class="actions"><input type="submit" onclick="return save()" class="hs-button primary large" value="Submit"></div>
    </form>
}
