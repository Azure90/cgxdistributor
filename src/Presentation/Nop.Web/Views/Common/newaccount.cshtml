@await Component.InvokeAsync("TopicBlock", new { systemName = "new-account" })
@await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.ContactUsTop })

@if (ViewBag.successmessage == "Success")
{
    <span style="
   font-weight: 700;
    margin: 25px;
    margin: 86px 452px;
    padding: 13px 57px;
    border-radius: -27px 20px 12px 17px;
    width: 640px;
    color: #270;
    background-color: #DFF2BF;
">Mail Sent Successfully!!</span>
}
else
{
    <form asp-route="new-account" method="post" class="custom-supportpage">
        <fieldset class="form-columns-2">
            <div class="hs_salutation hs-salutation hs-fieldtype-select field hs-form-field">
                <label id="label-salutation" class="" placeholder="Enter your Salutation" for="salutation">
                    <span>Salutation</span><span class="hs-form-required"></span>
                </label>
                <div class="input">
                    <select id="salutation" data_spnid="spnsalutation" required="" class="hs-input validation" name="salutation">
                        <option value="">@T("Support.select.Hint")</option>
                        <option value=" @T("Support.Dr.Hint")"> @T("Support.Dr.Hint")</option>
                        <option value=" @T("Support.Drs.Hint")"> @T("Support.Drs.Hint")</option>
                        <option value="@T("Support.Mr.Hint")">@T("Support.Mr.Hint")</option>
                        <option value=" @T("Support.Ms.Hint")"> @T("Support.Ms.Hint")</option>
                    </select>
                </div>
                <span id="spnsalutation" class="custom-validation"></span>
            </div>

            <div class="hs_firstname hs-firstname hs-fieldtype-text field hs-form-field">
                <label id="label-firstname" class="" placeholder="Enter your First name" for="firstname">
                    <span>@T("Support.FirstName.Hint")</span><span class="hs-form-required"></span>
                </label>
                <div class="input">
                    <input id="firstname" data_spnid="spnfirstname" name="firstname" required="" placeholder="" type="text" class="hs-input validation" inputmode="text" autocomplete="given-name" value="">
                </div>
                <span id="spnfirstname" class="custom-validation"></span>
            </div>

            <div class="hs_lastname hs-lastname hs-fieldtype-text field hs-form-field">
                <label id="label-lastname" class="" placeholder="Enter your Last name" for="lastname">
                    <span>@T("Support.LastName.Hint")</span>
                    <span class="hs-form-required"></span>
                </label>
                <div class="input">
                    <input id="lastname" data_spnid="spnlastname" name="lastname" required="" placeholder="" type="text" class="hs-input invalid error validation" inputmode="text" autocomplete="family-name" value="">
                </div>
                <span id="spnlastname" class="custom-validation"></span>
            </div>
        </fieldset>
        <fieldset class="form-columns-2">
            <div class="hs_clinic_name hs-clinic_name hs-fieldtype-text field hs-form-field">
                <label id="label-clinic_name" class="" placeholder="Enter your Clinic / Practice / Business name" for="clinic_name">
                    <span>@T("newaccount.Clinic/Practice/Businessname.Hint")</span><span class="hs-form-required"></span>
                </label><legend class="hs-field-desc" style="display: block;">This field is used as the "Company name" to create a Hubspot Company contact so if there is no official clinic or practice name, please enter the Doctor's name as it appears in Accpac. DO NOT TYPE SOMETHING LIKE "NONE".</legend><div class="input">
                    <input id="clinic_name" data_spnid="spnclinic_name" name="clinic_name" required="" placeholder="" type="text" class="hs-input validation" inputmode="text" value="">
                </div>
                <span id="spnclinic_name" class="custom-validation"></span>
            </div>
            <div class="hs_website hs-website hs-fieldtype-text field hs-form-field">
                <label id="label-website" class="" placeholder="Enter your Website URL" for="website"><span>@T("newaccount.WebsiteURL.Hint")</span></label>
                <legend class="hs-field-desc" style="display: block;">@T("newaccount.Websiteforclinic/practice/company.Hint")</legend>
                <div class="input">
                    <input id="website" data_spnid="spnwebsite" name="website" placeholder="" type="text" class="hs-input " inputmode="url" value="">
                </div>
                <span id="spnwebsite" class="custom-validation"></span>
            </div>
        </fieldset>

        <fieldset class="form-columns-2">
            <div class="hs_email hs-email hs-fieldtype-text field hs-form-field">
                <label id="label-email" class="" placeholder="Enter your Email" for="email">
                    <span>@T("Support.Email.Hint")</span>
                    <span class="hs-form-required"></span>
                </label><legend class="hs-field-desc" style="display: block;">@T("newaccount.Emailfordoctororaccountowner.Hint")</legend>
                <div class="input">
                    <input id="email" data_spnid="spnemail" name="email" required="" placeholder="" type="email" class="hs-input validation" inputmode="email" autocomplete="email" value="">
                </div>
                <span id="spnemail" class="custom-validation"></span>
            </div>
            <div class="hs_work_email hs-work_email hs-fieldtype-text field hs-form-field">
                <label id="label-work_email" class="" placeholder="Enter your Clinic/Practice | Main email" for="work_email">
                    <span>@T("newaccount.Clinic/Practice|Mainemail.Hint")</span>
                </label>
                <legend class="hs-field-desc" style="display: block;">@T("newaccount.secondaryemailreception.Hint")</legend>
                <div class="input">
                    <input id="work_email" data_spnid="spnwork_email" name="work_email" placeholder="" type="text" class="hs-input " inputmode="text" value="">
                </div>
                <span id="spnwork_email" class="custom-validation"></span>
            </div>
        </fieldset>

        <fieldset class="form-columns-2">
            <div class="hs_purchasing_contact hs-purchasing_contact hs-fieldtype-text field hs-form-field">
                <label id="label-purchasing_contact" class="" placeholder="Enter your Contact person | Orders" for="purchasing_contact">
                    <span>@T("newaccount.Contactperson|Orders.Hint")</span>
                </label>
                <legend class="hs-field-desc" style="display: block;">@T("newaccount.Contactinquiries.Hint")</legend>
                <div class="input">
                    <input id="purchasing_contact" data_spnid="spnpurchasing_contact" name="purchasing_contact" placeholder="" type="text" class="hs-input " inputmode="text" value="">
                </div>
                <span id="spnpurchasing_contact" class="custom-validation"></span>
            </div>
            <div class="hs_accounts_payable_contact hs-accounts_payable_contact hs-fieldtype-text field hs-form-field">
                <label id="label-accounts_payable_contact" class="" placeholder="Enter your Contact person | Accounts payable" for="accounts_payable_contact">
                    <span>@T("newaccount.Contact|Accountspayable.Hint")</span>
                </label>
                <legend class="hs-field-desc" style="display: block;">@T("newaccount.Contactadministrativeissues.Hint")</legend>
                <div class="input">
                    <input id="accounts_payable_contact" data_spnid="spnaccounts_payable_contact" name="accounts_payable_contact" placeholder="" type="text" class="hs-input " inputmode="text" value="">
                </div>
                <span id="spnaccounts_payable_contact" class="custom-validation"></span>
            </div>
        </fieldset>

        <fieldset class="form-columns-2">
            <div class="hs_clinic_payables_email_accounting_ hs-clinic_payables_email_accounting_ hs-fieldtype-text field hs-form-field">
                <label id="label-clinic_payables_email_accounting_" class="" placeholder="Enter your Clinic/Practice | Payables email (accounting)" for="clinic_payables_email_accounting_">
                    <span>@T("newaccount.Payableemailaccounting.Hint")</span><span class="hs-form-required"></span>
                </label>
                <legend class="hs-field-desc" style="display: block;">@T("newaccount.automaticallysendsinvoices.Hint")</legend>
                <div class="input">
                    <input id="clinic_payables_email_accounting_" data_spnid="spnclinic_payables_email_accounting_" name="clinic_payables_email_accounting_" required="" placeholder="@T("newaccount.placeholderpayablesoraccountant's.Hint")" type="text" class="hs-input validation" inputmode="text" value="">
                </div>
                <span id="spnclinic_payables_email_accounting_" class="custom-validation"></span>
            </div>
            <div class="hs_licence_nb hs-licence_nb hs-fieldtype-text field hs-form-field">
                <label id="label-licence_nb" class="" placeholder="Enter your Doctor's licence #" for="licence_nb">
                    <span>@T("newaccount.Doctor'slicence#.Hint")</span>
                    <span class="hs-form-required"></span>
                </label>
                <legend class="hs-field-desc" style="display: block;">@T("newaccount.doctor'slicensenumber.Hint")</legend>
                <div class="input">
                    <input id="licence_nb" data_spnid="spnlicence_nb" name="licence_nb" required="" placeholder="The license number can be found online." type="text" class="hs-input validation" inputmode="text" value="">
                </div>
                <span id="spnlicence_nb" class="custom-validation"></span>
            </div>
        </fieldset>

        <fieldset class="form-columns-2">
            <div class="hs_phone hs-phone hs-fieldtype-text field hs-form-field">
                <label id="label-phone" class="" placeholder="Enter your Phone number" for="phone">
                    <span>@T("newaccount.Phonenumber.Hint")</span>
                    <span class="hs-form-required"></span>
                </label>
                <legend class="hs-field-desc" style="display: block;"> @T("newaccount.IMPORTANTDASHES.Hint")</legend>
                <div class="input">
                    <input id="phone" name="phone" data_spnid="spnphone" required="" placeholder="1234567890" type="tel" class="hs-input validation" inputmode="tel" autocomplete="tel" value="">
                </div>
                <span id="spnphone" class="custom-validation"></span>
            </div>
            <div class="hs_fax hs-fax hs-fieldtype-text field hs-form-field">
                <label id="label-fax" class="" placeholder="Enter your Fax Number" for="fax">
                    <span>@T("newaccount.FaxNumber.Hint")</span>
                </label>
                <legend class="hs-field-desc" style="display: none;">
                </legend>
                <div class="input">
                    <input id="fax" name="fax" data_spnid="spnfax" placeholder="" type="text" class="hs-input " inputmode="text" autocomplete="fax" value="">
                </div>
                <span id="spnfax" class="custom-validation"></span>
            </div>
        </fieldset>

        <fieldset class="form-columns-2">
            <div class="hs_address hs-address hs-fieldtype-text field hs-form-field">
                <label id="label-address" class="" placeholder="Enter your Street address" for="address">
                    <span>@T("newaccount.Streetaddress.Hint")</span>
                    <span class="hs-form-required"></span>
                </label>
                <legend class="hs-field-desc" style="display: none;">
                </legend>
                <div class="input">
                    <input id="address" data_spnid="spnaddress" name="address" required="" placeholder="" type="text" class="hs-input validation" inputmode="text" autocomplete="street-address" value="">
                </div>
                <span id="spnaddress" class="custom-validation"></span>
            </div>
            <div class="hs_city hs-city hs-fieldtype-text field hs-form-field">
                <label id="label-city" class="" placeholder="Enter your City" for="city">
                    <span>@T("Catalogues.City.Hint")</span><span class="hs-form-required"></span>
                </label>
                <legend class="hs-field-desc" style="display: none;"></legend>
                <div class="input">
                    <input id="city" data_spnid="spncity" name="city" required="" placeholder="" type="text" class="hs-input validation" inputmode="text" autocomplete="address-level2" value="">
                </div>
                <span id="spncity" class="custom-validation"></span>
            </div>
        </fieldset>

        <fieldset class="form-columns-2">
            <div class="hs_zip hs-zip hs-fieldtype-text field hs-form-field">
                <label id="label-zip" class="" placeholder="Enter your Zip/Postal Code" for="zip">
                    <span>@T("newaccount.Zip/PostalCode.Hint")</span>
                    <span class="hs-form-required"></span>
                </label>
                <legend class="hs-field-desc" style="display: block;">@T("newaccount.H1H2V2.Hint")</legend>
                <div class="input">
                    <input id="zip" data_spnid="spnzip" name="zip" required="" placeholder="" type="text" class="hs-input validation" inputmode="text" value="">
                </div>
                <span id="spnzip" class="custom-validation"></span>
            </div>
            <div class="hs_state hs-state hs-fieldtype-select field hs-form-field">
                <label id="label-state" class="" placeholder="Enter your State/Province" for="state">
                    <span>@T("Support.State/Region.Hint")</span><span class="hs-form-required"></span>
                </label><legend class="hs-field-desc" style="display: none;">
                </legend><div class="input">
                    <select id="state" required="" data_spnid="spnstate" class="hs-input is-placeholder validation" name="state">
                        <option value="">@T("Support.select.Hint")</option>
                        <option value="AB">Alberta</option>
                        <option value="BC">British Columbia</option>
                        <option value="MB">Manitoba</option>
                        <option value="NB">New Brunswick</option>
                        <option value="NL">Newfoundland and Labrador</option>
                        <option value="NT">Northwest Territories</option>
                        <option value="NS">Nova Scotia</option>
                        <option value="NU">Nunavut</option>
                        <option value="ON">Ontario</option>
                        <option value="PE">Prince Edward Island</option>
                        <option value="QC">Quebec</option>
                        <option value="SK">Saskatchewan</option>
                        <option value="YT">Yukon</option>
                        <option value="AL">Alabama</option>
                        <option value="AK">Alaska</option>
                        <option value="AZ">Arizona</option>
                        <option value="AR">Arkansas</option>
                        <option value="CA">California</option>
                        <option value="CO">Colorado</option>
                        <option value="CT">Connecticut</option>
                        <option value="DE">Delaware</option>
                        <option value="FL">Florida</option>
                        <option value="GA">Georgia</option>
                        <option value="HI">Hawaii</option>
                        <option value="ID">Idaho</option>
                        <option value="IL">Illinois</option>
                        <option value="IN">Indiana</option>
                        <option value="IA">Iowa</option>
                        <option value="KC">Kansas</option>
                        <option value="KY">Kentucky</option>
                        <option value="LA">Louisiana</option>
                        <option value="ME">Maine</option>
                        <option value="MD">Maryland</option>
                        <option value="MA">Massachusetts</option>
                        <option value="MI">Michigan</option>
                        <option value="MN">Minnesota</option>
                        <option value="MS">Mississippi</option>
                        <option value="MO">Missouri</option>
                        <option value="MT">Montana</option>
                        <option value="NE">Nebraska</option>
                        <option value="NV">Nevada</option>
                        <option value="NH">New Hampshire</option>
                        <option value="NJ">New Jersey</option>
                        <option value="NM">New Mexico</option>
                        <option value="NY">New York</option>
                        <option value="NC">North Carolina</option>
                        <option value="ND">North Dakota</option>
                        <option value="OH">Ohio</option>
                        <option value="OK">Oklahoma</option>
                        <option value="OR">Oregon</option>
                        <option value="PA">Pennsylvania</option>
                        <option value="PR">Puerto Rico</option>
                        <option value="RI">Rhode Island</option>
                        <option value="SC">South Carolina</option>
                        <option value="SD">South Dakota</option>
                        <option value="TN">Tennessee</option>
                        <option value="TX">Texas</option>
                        <option value="UT">Utah</option>
                        <option value="VT">Vermont</option>
                        <option value="VA">Virginia</option>
                        <option value="WA">Washington</option>
                        <option value="WV">West Virginia</option>
                        <option value="WI">Wisconsin</option>
                        <option value="WY">Wyoming</option>
                    </select>
                </div>
                <span id="spnstate" class="custom-validation"></span>
            </div>
        </fieldset>

        <fieldset class="form-columns-1">
            <div class="hs-dependent-field">
                <div class="hs_country hs-country hs-fieldtype-select field hs-form-field">
                    <label id="label-country" class="" placeholder="Enter your Country" for="country">
                        <span>@T("Support.Country.Hint")</span><span class="hs-form-required"></span>
                    </label><legend class="hs-field-desc" style="display: none;">
                    </legend><div class="input">
                        <select id="country" data_spnid="spncountry" required="" class="hs-input is-placeholder validation" name="country">
                            <option value="">@T("Support.select.Hint")</option>
                            <option value="Asia/Pacific Region">Asia/Pacific Region</option>
                            <option value="Australia">Australia</option>
                            <option value="Canada">Canada</option>
                            <option value="Europe">Europe</option>
                            <option value="United States">United States</option>
                            <option value="Africa">Africa</option>
                            <option value="South America">South America</option>
                        </select>
                    </div>
                    <span id="spncountry" class="custom-validation"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="form-columns-2">
            <div class="hs_field_of_study hs-field_of_study hs-fieldtype-checkbox field hs-form-field">
                <label id="label-field_of_study" class="" placeholder="Enter your Field Specialty" for="field_of_study">
                    <span>@T("Support.FieldSpecialty.Hint")</span>
                    </label><legend class="hs-field-desc" style="display: none;"></legend><div class="input">
                    <ul role="checkbox" class="inputs-list multi-container">
                        <li class="hs-form-checkbox" role="checkbox">
                            <label for="field_of_study0" class="hs-form-checkbox-display">
                                <input id="field_of_study0" class="hs-input" type="checkbox" name="field_of_study" value="General Practitioner">
                                <span>@T("Support.GeneralPractitioner.Hint")</span>
                            </label>
                        </li>
                        <li class="hs-form-checkbox" role="checkbox">
                            <label for="field_of_study1" class="hs-form-checkbox-display">
                                <input id="field_of_study1" class="hs-input" type="checkbox" name="field_of_study" value="OMS">
                                <span>@T("Support.Oral&amp;MaxillofacialSurgery.Hint")</span>
                            </label>
                        </li>
                        <li class="hs-form-checkbox" role="checkbox">
                            <label for="field_of_study2" class="hs-form-checkbox-display">
                                <input id="field_of_study2" class="hs-input" type="checkbox" name="field_of_study" value="Periodontist">
                                <span>@T("Support.Periodontist.Hint")</span>
                            </label>
                        </li>
                        <li class="hs-form-checkbox" role="checkbox">
                            <label for="field_of_study3" class="hs-form-checkbox-display">
                                <input id="field_of_study3" class="hs-input" type="checkbox" name="field_of_study" value="Orthodontist">
                                <span>@T("Support.Orthodontist.Hint")</span>
                            </label>
                        </li>
                        <li class="hs-form-checkbox" role="checkbox">
                            <label for="field_of_study4" class="hs-form-checkbox-display">
                                <input id="field_of_study4" class="hs-input" type="checkbox" name="field_of_study" value="Endodontist">
                                <span>@T("Support.Endodontist.Hint")</span>
                            </label>
                        </li>
                        <li class="hs-form-checkbox" role="checkbox">
                            <label for="field_of_study5" class="hs-form-checkbox-display">
                                <input id="field_of_study5" class="hs-input" type="checkbox" name="field_of_study" value="Prostodontist">
                                <span>@T("Support.Prosthodontist.Hint")</span>
                            </label>
                        </li>
                        <li class="hs-form-checkbox" role="checkbox">
                            <label for="field_of_study6" class="hs-form-checkbox-display">
                                <input id="field_of_study6" class="hs-input" type="checkbox" name="field_of_study" value="Pediatric Dentistry">
                                <span>@T("Support.PediatricDentistry.Hint")</span>
                            </label>
                        </li>
                        <li class="hs-form-checkbox" role="checkbox">
                            <label for="field_of_study7" class="hs-form-checkbox-display">
                                <input id="field_of_study7" class="hs-input" type="checkbox" name="field_of_study" value="Oral Medicine &amp; Pathology">
                                <span>@T("Support.OralMedicine&amp;Pathology.Hint")</span>
                            </label>
                        </li>
                        <li class="hs-form-checkbox" role="checkbox">
                            <label for="field_of_study8" class="hs-form-checkbox-display">
                                <input id="field_of_study8" class="hs-input" type="checkbox" name="field_of_study" value="Other">
                                <span>@T("Support.Other.Hint")</span>
                            </label>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="hs_mobilephone hs-mobilephone hs-fieldtype-text field hs-form-field">
                <label id="label-mobilephone" class="" placeholder="Enter your Doctor's cell phone if available" for="mobilephone">
                    <span>@T("newaccount.Doctor'sphoneavailable.Hint")</span></label>
                <legend class="hs-field-desc" style="display: none;"></legend><div class="input">
                    <input id="mobilephone" data_spnid="spnmobilephone" name="mobilephone" placeholder="" type="text" class="hs-input" inputmode="text" autocomplete="tel" value="">
                </div>
                <span id="spnmobilephone" class="custom-validation"></span>
            </div>
        </fieldset>
        <fieldset class="form-columns-1">
            <div class="hs-dependent-field">
                <div class="hs_account_type hs-account_type hs-fieldtype-select field hs-form-field">
                    <label id="label-account_type" class="" placeholder="Enter your Account type" for="account_type">
                        <span>@T("newaccount.Accounttype.Hint")</span><span class="hs-form-required"></span>
                    </label>
                    <legend class="hs-field-desc" style="display: block;">@T("newaccount.opening?Distributor.Hint")</legend>
                    <div class="input">
                        <select id="account_type" data_spnid="spnaccount_type" required="" class="hs-input is-placeholder validation" name="account_type">
                            <option value="">@T("Support.select.Hint")</option>
                            <option value="@T("newaccount.Distributor.Hint")">@T("newaccount.Distributor.Hint")</option>
                            <option value="@T("newaccount.Independentrep.Hint")">@T("newaccount.Independentrep.Hint")</option>
                            <option value="@T("newaccount.Dentalclinic(Canada).Hint")">@T("newaccount.Dentalclinic(Canada).Hint")</option>
                            <option value="@T("newaccount.Dentalclinic(US).Hint")">@T("newaccount.Dentalclinic(US).Hint")</option>
                            <option value="@T("newaccount.Podiatryclinic.Hint")">@T("newaccount.Podiatryclinic.Hint")</option>
                        </select>
                    </div>
                    <span id="spnaccount_type" class="custom-validation"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="form-columns-1">
            <div class="hs-dependent-field">
                <div class="hs_ship_to_address hs-ship_to_address hs-fieldtype-radio field hs-form-field">
                    <label id="label-ship_to_address" class="" placeholder="Enter your Ship to address?" for="ship_to_address">
                        <span>@T("newaccount.Shiptoaddress?.Hint")</span><span class="hs-form-required"></span>
                    </label>
                    <legend class="hs-field-desc" style="display: none;"></legend>
                    <div class="input">
                        <ul required="" role="checkbox" class="inputs-list multi-container validation">
                            <li class="hs-form-radio" role="radio">
                                <label for="ship_to_address0" class="hs-form-radio-display">
                                    <input id="ship_to_address0" data_spnid="spnship_to_address1" class="hs-input Speciality validation" type="radio" name="ship_to_address" value="Yes">
