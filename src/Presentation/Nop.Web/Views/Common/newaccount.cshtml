                            <li class="hs-form-radio" role="radio">
                                <label for="ship_to_address1" class="hs-form-radio-display">
                                    <input id="ship_to_address1" data_spnid="spnship_to_address2" class="hs-input Speciality validation" type="radio" name="ship_to_address" value="No">
                                    <span>@T("newaccount.No(sameasbilling).Hint")</span>
