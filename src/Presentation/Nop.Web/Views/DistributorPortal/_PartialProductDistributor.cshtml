@using Nop.Web.Models.DistributorPortal;
@model DistributorPortalModel
@{
    int currentPage = Model.CurrentPage;
    int totalPages = Model.TotalPages;
    int size = Model.PageSize;
}
@{
    int[] pageSizes = new[] { 8, 12, 16, 20 };
    var procount = Model.ProductList.Where(d => d.ModuleName == "Training Courses" && d.SubModuleName == "Virtual Training Request").Count();
    var virtualcount = "";
    if (Model.virtualtraining != null)
    {
        virtualcount = "notdisplay";
    }

}
<style>
    .hover-container {
        position: relative;
        display: inline-block;
    }

    .hover-text {
        display: none;
        position: absolute;
        top: -79%;
        /* left: -50px; */
        right: -19px;
        background-color: #f9f9f9;
        padding: 5px 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        white-space: nowrap;
        z-index: 1;
    }

    .hover-container:hover .hover-text {
        display: block;
    }
</style>

@{

    int maxPagesToShow = 4;

    int startPage = Math.Max(1, currentPage - (maxPagesToShow / 2));
    int endPage = startPage + maxPagesToShow - 1;

    if (endPage > totalPages)
    {
        endPage = totalPages;
        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
    }
}

@if (procount <= 0)
{

    <div class="product-page-sizes">
        <select id="products-pagesize" name="products-pagesize" class="productsPageSizeDropDown">
            @foreach (var pageSize in pageSizes)
            {
                <option value="@pageSize" selected="@(Model.PageSize == pageSize ? "selected" : null)">
                    @pageSize
                </option>
            }
        </select>
        <span>per page</span>
    </div>

}

<div id="tempDataMessage">@TempData["Message"]</div>
<div style="margin: 0 0 47px;" class="virtualimage  pro_row @(Model.ProductList.Any(x => x.SubModuleName == "Video") ? "videogrid" : Model.ProductList.Any(x => x.SubModuleName == "Image") ? "imageGrid": "")">

    @foreach (var data in Model.ProductList.GroupBy(x => x.Id).Select(g => g.First()))
    {
        if (@* data.ModuleName != "Social Media" && *@ data.SubModuleName != "Virtual Training Request")
        {
            <div class="pro_box_outer">
                <div class="pro_img">
                    @if (data.ModuleName == "Training Courses")
                    {
                        <a href="@Url.Action("ProductDetailPage", "DistributorPortal", new { pid = data.Id,s=data.IsSample,a=data.Sku})">
                            <img src="@data.Image" alt="Product Image" />
                        </a>
                    }
                    else
                    {
                        @if (data.IsSample == false)
                        {
                            <a href="@Url.Action("ProductDetailPage", "DistributorPortal", new { pid = data.Id,s=data.IsSample,a=data.Sku})">
                                <img src="@data.Image" alt="Product Image" />
                            </a>
                        }
                        else
                        {
                            <a href="/@data.UrlSlug">
                                <img src="@data.Image" alt="Product Image" />
                            </a>
                        }

                    }
                </div>

                <div class="pro_details">
                    @* <div class="pro_breadcrumb">
            <b>Products:</b>
            <p>
            Regen Biomaterials > Bone Graft > Allografts
            </p>
            </div> *@
                    @if (data.ModuleName == "Training Courses")
                    {
                        <a href="@Url.Action("ProductDetailPage", "DistributorPortal", new { pid = data.Id,s=data.IsSample,a=data.Sku})">
                            <p class="pro_trademark"><b>@data.Name</b></p>
                        </a>
                    }
                    else
                    {
                        @if (data.IsSample == false)
                        {
                            <a href="@Url.Action("ProductDetailPage", "DistributorPortal", new { pid = data.Id,s=data.IsSample,a=data.Sku})">
                                <p class="pro_trademark"><b>@data.Name</b></p>
                            </a>
                        }
                        else
                        {
                            <a href="/@data.UrlSlug">
                                <p class="pro_trademark"><b>@data.Name</b></p>
                            </a>
                        }

                    }
                    @if (data.ShortDescription != null)
                    {
                        @if (data.ShortDescription.Contains("$$"))
                        {

                            var aa = data.ShortDescription.Split("$$");
                            <a>
                                <p>@Html.Raw(aa[0])</p>
                            </a>
                        }

                    }

                    @if (data.ModuleName == "Products" || data.ModuleName == "Social Media")
                    {
                        <ul class="pro_attributes">
                            <li><img src="~/images/picture.svg" /> Pictures</li>
                            <li><img src="~/images/documents.svg" /> Documents</li>
                            <li><img src="~/images/videos.svg" /> Videos</li>
                            @if (data.socialmediashow == "show")
                            {
                                <li style="grid-column: span 2;"><img src="~/images/social-media.svg" /> Social Media</li>
                            }
                        </ul>
                    }
                    @if (data.ModuleName != "Training Courses")
                    {
                        @if (data.IsSample == true)
                        {
                            <div class="pro_link"><a class="add-to-cart-button btnmoreinfo" href="/@data.UrlSlug"><span>Add To Cart</span></a></div>

                        }
                        else if (data.SubModuleName == "Image")
                        {
                            <a class="zoom-in-button btneducation">
                                <span>
