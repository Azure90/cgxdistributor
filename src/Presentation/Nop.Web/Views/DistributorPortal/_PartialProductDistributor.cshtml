                                </span>
                            </a>



                            <div class="pro_link">
                                <a class="add-to-cart-button btneducation"><span>Download Image</span></a>

                            </div>


                        }
                        else
                        {
                            <div class="pro_link"><a class="add-to-cart-button btnmoreinfo" href="@Url.Action("ProductDetailPage", "DistributorPortal", new { pid = data.Id,s=data.IsSample, a="0",sm=data.socialmediashow})" @* href="/@data.UrlSlug" *@><span>More information</span></a></div>
                        }
                    }
                    else
                    {
                        <div class="pro_link"><a class="add-to-cart-button btnmoreinfo" href="@Url.Action("ProductDetailPage", "DistributorPortal", new { pid = data.Id,s=data.IsSample,a=data.Sku})" @* href="@data.UrlSlug" *@><span>Access to course</span></a></div>
                        @* @Html.Raw(data.UrlSlug) *@
                    }
                </div>
            </div>
        }

        else
        {
            <div class="pro_box_outer image_overlay">
                <div class="pro_img" style="position: relative">
                    @if (data.SubModuleName == "Image")
                    {

                        <img style="object-fit: cover" src="@data.Image" alt="Product Image" />

                    }
                    else
                    {
                        <iframe src="@data.Image"
                                width="640" height="360"
                                frameborder="0"
                                allow="autoplay; fullscreen; picture-in-picture"
                                allowfullscreen>
                        </iframe>

                    }
                    @if (data.SubModuleName == "Image")
                    {
                        <div class="pro_details video_title_bottom">
