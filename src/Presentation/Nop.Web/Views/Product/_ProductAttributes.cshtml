                                $("#product_attribute_" + diff[i] + " option ").css("display", "none").prop("selected", false);
                                $("#product_attribute_" + diff[i] + " option[value=0]").css("display", "block");
                                $("#product_attribute_" + diff[i] + " option ").prop('selectedIndex', 0);
                                //$("#product_attribute_" + diff[i] + " option ").val(0);
