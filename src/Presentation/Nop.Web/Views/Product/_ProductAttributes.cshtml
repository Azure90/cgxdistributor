                        }
                        else {
                            var firstddl = $(".attributes Select").get(0);
                            var selectfirstid = $(firstddl).attr("id");
                            var selectedddlvalue = $("#" + selectfirstid).val();
                            var attributesNotvalue = data.DDlNotids.split(",");
                            for (var i = 0; i < attributesNotvalue.length; i++) {
                                //var ddlloopid = "product_attribute_" + diff[i];
                                //$("#product_attribute_" + attributesNotvalue[i] + " option ").css("display", "none").prop("selected", false);
                                //$("#product_attribute_" + attributesNotvalue[i] + " option[value=0]").css("display", "block");
                                //$("#product_attribute_" + attributesNotvalue[i] + " option ").prop('selectedIndex', 0);

                            }
                            //alert(selectedddlvalue);
                            $("#" + selectfirstid + " option ").css("display", "block");
                            $("#" + selectfirstid).val(selectedddlvalue);

                            // $('.price-value-@productId').text("$0.00");
                            //$(".attributes Select  option ").css("display", "block").get(0);
                        }
                        if (data.IsRolesActive) {
                            
                            $(".product-price").append("<span class='WarningMessage'style='color: red;display: none;'>Product not available</span>");
                            $(".WarningMessage").fadeIn();
                            $("#add-to-cart-button-@productId").css("pointer-events", "none").css("background-color", "gray");
                            $("#add-to-wishlist-button-@productId").css("pointer-events", "none").css("background-color", "gray");
                            $('.price-value-@productId').text("");
                            return false;
                        }
                        if (data.islogin == "true") {

                            if (data.price != "$0.00") {

                                if (data.result != "") {
                                    if (data.Languageid == 2) {
                                        data.price = data.price.replace("$", "").replace(".", ",") + " $"
                                    }

                                    $('.price-value-@productId').text(data.price);
                                    console.log("yes")
                                    $("#add-to-cart-button-@productId").css("pointer-events", "unset").css("background-color", "#88a900");
                                    $("#add-to-wishlist-button-@productId").css("pointer-events", "unset").css("background-color", "#88a900");
                                }
                                //$('.additional-details').html('');
                                var ChildSku = "<div class='manufacturer-part-number'><span class='label'>Part Number:</span> <span class='value' id='mpn-4053'>" + data.sku + "</span></div>";
                                if ($(".additional-details .manufacturer-part-number:visible").length > 1) {
                                    $(".additional-details").find('.manufacturer-part-number:visible').eq(1).remove();
                                }


                            }
                        }

                        if (data.basepricepangv) {
                            $('#base-price-pangv-@productId').text(data.basepricepangv);
                        } else {
                            $('#base-price-pangv-@productId').hide();
                        }
                        if (data.sku) {
                            $('#sku-@productId').text(data.sku).parent(".sku").show();

                        } else {
                            $('#sku-@productId').parent(".sku").hide();
                        }
                        if (data.mpn) {
                            if ($("#hdnnumber").val() == "true") {

                                $('#mpn-@productId').text(data.mpn).parent(".manufacturer-part-number").show();
                            }
                            else {
                                $('#mpn-@productId').text(data.mpn).parent(".manufacturer-part-number").hide();
                            }
                            if (data.oldsku) {
                                var ChildSku = "<div class='oldsku'><span class='label'>@T("_productAttributes.Manufacturer's")</span> <span class='value'>" + data.oldsku + "</span></div>";
                                if ($(".additional-details .oldsku").length > 0) {
                                    $(".additional-details .oldsku").remove();
                                }
                                $(".additional-details").append(ChildSku);

                            }

                        } else {
                            $(".additional-details .oldsku").remove();
                            $('#mpn-@productId').parent(".manufacturer-part-number").hide();
                        }
                        //$(".additional-details .manufacturer-part-number:visible .value").text("Testing");
                        if (data.gtin) {
                            $('#gtin-@productId').text(data.gtin).parent(".gtin").show();
                        } else {
                            $('#gtin-@productId').parent(".gtin").hide();
                        }
                        if (data.stockAvailability) {
                            $('#stock-availability-value-@productId').text(data.stockAvailability);
                        }
                        if (data.enabledattributemappingids) {
                            for (var i = 0; i < data.enabledattributemappingids.length; i++) {
                                $('#@(NopCatalogDefaults.ProductAttributePrefix)label_' + data.enabledattributemappingids[i]).show();
                                $('#@(NopCatalogDefaults.ProductAttributePrefix)input_' + data.enabledattributemappingids[i]).show();
                            }
                        }
                        if (data.disabledattributemappingids) {
                            for (var i = 0; i < data.disabledattributemappingids.length; i++) {
                                $('#@(NopCatalogDefaults.ProductAttributePrefix)label_' + data.disabledattributemappingids[i]).hide();
                                $('#@(NopCatalogDefaults.ProductAttributePrefix)input_' + data.disabledattributemappingids[i]).hide();
                            }
                        }

                        if (data.pictureDefaultSizeUrl) {
                            $(".picture-wrapper img").attr("src", data.pictureDefaultSizeUrl);
                            $('#main-product-img-@productId').attr("src", data.pictureDefaultSizeUrl);
                        }
                        if (data.pictureFullSizeUrl) {
                            $(".picture-wrapper a").attr("href", data.pictureFullSizeUrl);
                            $('#main-product-img-lightbox-anchor-@productId').attr("href", data.pictureFullSizeUrl);
                        }
                        if (data.message) {
                            alert(data.message);
                        }

                        $(document).trigger({ type: "product_attributes_changed", changedData: data });
                    }
                });
            }
            $(document).ready(function () {
            @(attributeChangeHandlerFuncName)();
            @Html.Raw(attributeChangeScriptsBuilder.ToString()
            )

                                                                                                                                                                                                                                                });
        </script>
    }
}


