@using System.Text.Json;
@model ProductDetailsModel


@if (Model.ShowPreOrderSection)
{
    var datePickerFormat = Html.GetJQueryDateFormat();//java-script format

    var scheduledTitle = @T("Account.PreOrders.PreOrder.Title").Text;

    <div id="preorder-feature-section" class="preorder-section">

        <style>
            .preorder-section {
                margin: 20px 0;
                padding: 20px;
                border: 1px solid #ececec;
                background: #fff;
            }

            .preorder-title {
                margin: 0 0 18px;
                font-size: 20px;
                font-weight: 600;
                color: #333;
            }

            .order-cards {
                display: flex;
                gap: 15px;
                margin-bottom: 18px;
            }

            .order-card {
                position: relative;
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 16px;
                border: 1px solid #ddd;
                border-radius: 8px;
                cursor: pointer;
                transition: .25s;
                background: #fff;
            }

                .order-card:hover {
                    border-color: #9dc43c;
                }

                .order-card.active {
                    border-color: #9dc43c;
                    box-shadow: 0 0 0 2px rgba(157,196,60,.12);
                }

                .order-card input {
                    display: none;
                }

            .checkmark {
                position: absolute;
                top: 12px;
                right: 12px;
                width: 16px;
                height: 16px;
                border-radius: 50%;
                border: 2px solid #9dc43c;
            }

            .order-card.active .checkmark {
                background: #9dc43c;
                box-shadow: inset 0 0 0 3px #fff;
            }

            .icon {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                background: #eef7de;
                display: flex;
                justify-content: center;
                align-items: center;
                flex-shrink: 0;
            }

                .icon i {
                    color: #8bb530;
                    font-size: 22px;
                }

            .text-preorder h4 {
                margin: 0;
                font-size: 18px;
                font-weight: 600;
            }

            .text-preorder p {
                margin: 6px 0 0;
                font-size: 13px;
                line-height: 20px;
                color: #777;
            }

            .preorder-panel {
                background: #fafafa;
                border: 1px solid #ececec;
                border-radius: 8px;
                padding: 18px;
            }

            .field-preorder {
                margin-bottom: 18px;
            }

                .field-preorder label {
                    display: block;
                    font-size: 14px;
                    font-weight: 600;
                    margin-bottom: 8px;
                }

                .field-preorder select {
                    width: 100%;
                    height: 40px;
                    padding: 0 12px;
                    border: 1px solid #ddd;
                    border-radius: 4px;
                }

            .qty-box-preorder {
                display: flex;
                align-items: center;
                width: 130px;
                border: 1px solid #ddd;
                border-radius: 4px;
                overflow: hidden;
                background: #fff;
            }

                .qty-box-preorder button {
                    width: 36px;
                    height: 36px;
                    border: 0;
                    background: #f5f5f5;
                    cursor: pointer;
                    font-size: 18px;
                    color: #555;
                }

                    .qty-box-preorder button:hover {
                        background: #9dc43c;
                        color: #fff;
                    }

                .qty-box-preorder input {
                    width: 58px;
                    height: 36px;
                    border: 0;
                    text-align: center;
                    font-size: 14px;
                }

            .info-box {
                display: flex;
                gap: 10px;
                padding: 12px;
                background: #fff;
                border-left: 3px solid #9dc43c;
                color: #666;
                font-size: 13px;
            }

                .info-box i {
                    color: #9dc43c;
                    font-size: 16px;
                }

            .preorder-dialog-buttons {
                display: flex;
                justify-content: center;
                gap: 8px;
                margin-top: 0px;
            }

                .preorder-dialog-buttons .button-1 {
                    width: 130px;
                    height: 40px;
                    padding: 0;
                    font-size: 12px;
                    line-height: 32px;
                }

                    .preorder-dialog-buttons .button-1:hover {
                        background: #5f7600 !important;
                    }

            .preorder-disabled {
                opacity: 0.5;
                /* pointer-events: none; */
            }

            .preorder-not-available-message {
                color: red;
                font-size: 13px;
                line-height: 1.5;
                font-weight: 600;
            }
        </style>

        <h3 class="preorder-title">Choose Order Type</h3>
        <div class="order-cards">

            <!-- Regular -->
            <div class="order-card active">
                <input type="radio"
                       name="OrderType"
                       value="Regular"
                       checked>

                <span class="checkmark"></span>
                <div class="icon">
                    <svg version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px"
                         width="16px" height="20px" viewBox="0 -2 16 20" enable-background="new 0 -2 16 20" xml:space="preserve">
                    <path fill="#5F7600" d="M15,2h-3.1c-0.1-0.9-0.4-2-1.1-2.9C10.1-1.6,9.2-2,8-2C6.8-2,5.9-1.6,5.2-0.8C4.5,0,4.2,1.1,4.1,2H1L0,18h16L15,2z M6-0.2
	                        C6.5-0.7,7.1-1,8-1s1.5,0.3,2,0.8c0.5,0.5,0.7,1.4,0.8,2.2H5.1C5.3,1.3,5.5,0.4,6-0.2z M1.1,17L1.9,3h2.1c0,0.3,0,0.9,0,1h1
	                        c0,0,0-0.6,0-1h5.9c0,0.3,0,1,0,1l1,0c0-0.1,0-0.7,0-1h2.1l0.9,14H1.1z" />
                        </svg>
                </div>

                <div class="text-preorder">
                    <h4>
                        @T("Account.PreOrders.RegularOrder.Title")
                    </h4>

                    <p>
                        @T("Account.PreOrders.RegularOrder.ShortDescription")
                    </p>
                </div>
            </div>

            <!-- PreOrder -->
            <div class="order-card">
                <input type="radio"
                       name="OrderType"
                       value="PreOrder">

                <span class="checkmark"></span>

                <div class="icon">
                    <svg fill="#5F7600" width="64px" height="64px" viewBox="-4.2 -4.2 28.40 28.40" data-name="Capa 1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" stroke="#5F7600" stroke-width="0.0002" transform="matrix(1, 0, 0, 1, 0, 0)rotate(0)">
                        <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                        <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round" stroke="#CCCCCC" stroke-width="0.08"></g>
                        <g id="SVGRepo_iconCarrier">
                            <path d="M13.87,6.08h-.68V5.16a.38.38,0,0,0-.75,0v.92h-5V5.16a.38.38,0,0,0-.75,0v.92h-.6A1.72,1.72,0,0,0,4.41,7.8v5.53a1.73,1.73,0,0,0,1.72,1.73h7.74a1.73,1.73,0,0,0,1.72-1.73V7.8A1.72,1.72,0,0,0,13.87,6.08Zm1,7.25a1,1,0,0,1-1,1H6.13a1,1,0,0,1-1-1V7.8a1,1,0,0,1,1-1h.6v1a.38.38,0,0,0,.75,0v-1h5v1a.38.38,0,0,0,.75,0v-1h.68a1,1,0,0,1,1,1Z"></path>
                            <path d="M7.15,9.41h-.1a.38.38,0,0,0-.37.38.37.37,0,0,0,.37.37h.1a.37.37,0,0,0,.38-.37A.38.38,0,0,0,7.15,9.41Z"></path>
                            <path d="M9.15,9.41h-.1a.38.38,0,0,0-.37.38.37.37,0,0,0,.37.37h.1a.37.37,0,0,0,.38-.37A.38.38,0,0,0,9.15,9.41Z"></path>
                            <path d="M11,9.41h-.1a.38.38,0,0,0-.38.38.37.37,0,0,0,.38.37H11a.37.37,0,0,0,.38-.37A.38.38,0,0,0,11,9.41Z"></path>
                            <path d="M12.86,9.41h-.1a.38.38,0,0,0-.37.38.37.37,0,0,0,.37.37h.1a.37.37,0,0,0,.38-.37A.38.38,0,0,0,12.86,9.41Z"></path>
                            <path d="M7.15,11.62h-.1a.38.38,0,0,0,0,.75h.1a.38.38,0,1,0,0-.75Z"></path>
                            <path d="M9.15,11.62h-.1a.38.38,0,0,0,0,.75h.1a.38.38,0,1,0,0-.75Z"></path>
                            <path d="M11,11.62h-.1a.38.38,0,1,0,0,.75H11a.38.38,0,1,0,0-.75Z"></path>
                            <path d="M12.86,11.62h-.1a.38.38,0,0,0,0,.75h.1a.38.38,0,1,0,0-.75Z"></path>
                        </g>
                    </svg>
                </div>

                <div class="text-preorder">
                    <h4>
                        @scheduledTitle
                    </h4>
                    <p>
                        @T("Account.PreOrders.PreOrder.ShortDescription")
                    </p>
                </div>
            </div>
        </div>

        <div class="preorder-panel">
            <div class="field-preorder">
                <label>Preferred Delivery Date</label>
                <div class="preorder-attributes preorder-datapicker">

                    <input id="PreferredDeliveryDate"
                           type="text"
                           name="PreferredDeliveryDate"
                           class="datepicker"
                           value="@(Model.PreferredDeliveryDate?.ToString("yyyy-MM-dd"))"
                           data-previous-date="@(Model.PreferredDeliveryDate?.ToString("yyyy-MM-dd"))"
                           readonly />

                    <script asp-location="Footer">
                        $(document).ready(function () {

                            const preOrderSettings = {
                                minimumLeadTime: @Model.MinimumLeadTime,      // e.g. 42 days
                                endDate: '@(Model.DeliveryEndDate?.ToString("yyyy-MM-dd") ?? "")',
                                blackoutRanges: new Set(@Html.Raw(JsonSerializer.Serialize(Model.BlackoutDates)))
                            };

                            preOrderSettings.blackoutRanges.forEach(function (range) {

                                range.StartDate = new Date(range.StartDate);
                                range.EndDate = new Date(range.EndDate);

                                range.StartDate.setHours(0, 0, 0, 0);
                                range.EndDate.setHours(0, 0, 0, 0);
                            });

                            $("#PreferredDeliveryDate").datepicker({
                                dateFormat: "@datePickerFormat",

                                // Earliest available date
                                minDate: preOrderSettings.minimumLeadTime,

                                // Maximum 12 months from today
                                // maxDate: "+12m",

                                // Maximum date customer can select
                                maxDate: preOrderSettings.endDate,

                                changeMonth: true,
                                changeYear: true,
                                showButtonPanel: false,
                                onSelect: function (selectedDate) {

                                    var savedDate = $("#PreferredDeliveryDate").attr("data-previous-date");

                                    // No cart date -> never show dialog
                                    if (!savedDate) {
                                        currentPreferredDate = selectedDate;
                                        return;
                                    }

                                    // Same date
                                    if (currentPreferredDate === selectedDate)
                                        return;

                                    pendingPreferredDate = selectedDate;

                                    $("#change-preorder-date-dialog").dialog("open");
                                },
                                beforeShow: function () {
                                    setTimeout(function () {
                                        $("#ui-datepicker-div")
                                            .attr("class", function (i, css) {
                                                return css.replace(/\bpreorder-datepicker\b/g, "");
                                            })
                                            .addClass("preorder-datepicker");
                                    }, 0);
                                },
                                onClose: function () {
                                    $("#ui-datepicker-div").removeClass("preorder-datepicker");
                                },
                                beforeShowDay: function (date) {

                                    // Weekend
                                    if (date.getDay() === 0 || date.getDay() === 6)
                                        return [false, "preorder-disabled", "Weekend delivery is unavailable"];

                                    date.setHours(0, 0, 0, 0);

                                    for (const range of preOrderSettings.blackoutRanges) {

                                        if (date >= range.StartDate && date <= range.EndDate)
                                            return [false, "preorder-disabled", range.Reason];
                                    }

                                    return [true, "", ""];
                                }
                            });
                        });
                    </script>
                </div>
            </div>

            <div class="info-box">
                <svg fill="#88A900" height="24px" width="24px" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 512 512" xml:space="preserve" stroke="#88A900">
                    <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier"><g><g><path d="M256,0C114.84,0,0,114.84,0,256s114.84,256,256,256s256-114.84,256-256S397.16,0,256,0z M256,480 C132.488,480,32,379.512,32,256S132.48,32,256,32c123.512,0,224,100.488,224,224S379.512,480,256,480z"></path></g></g>
                    <g><g><path d="M280.792,127.52c-5.8-5.896-12.888-8.848-21.288-8.848c-8.288,0-15.352,2.952-21.208,8.848 c-5.848,5.896-8.784,12.976-8.784,21.232c0,8.144,2.952,15.16,8.864,21.056c5.912,5.896,12.968,8.848,21.128,8.848 c8.272,0,15.344-2.912,21.2-8.76c5.856-5.832,8.784-12.88,8.784-21.144S286.592,133.416,280.792,127.52z"></path></g></g>
                    <g><g><polygon points="286.296,330.216 286.296,198 205.376,198 205.376,237.568 231.464,237.568 231.464,330.216 205.376,330.216 205.376,369.784 311.848,369.784 311.848,330.216 "></polygon></g></g></g>
                </svg>

                @T("Account.PreOrders.PreOrder.Description")
            </div>
        </div>

        <div id="change-preorder-date-dialog" style="display:none;">
            <div class="preorder-dialog-content">

                <div class="preorder-dialog-title">
                    Change Preferred Delivery Date?
                </div>

                <div class="preorder-dialog-message">
                    You already have @scheduledTitle item(s) in your cart.
                    <br /><br />
                    Changing the preferred delivery date will update the preferred delivery date for all @scheduledTitle items in your cart.
                    <br /><br />
                    <strong>Do you want to continue?</strong>
                </div>

                <div class="preorder-dialog-buttons">
                    <button type="button" id="btnKeepCurrentDate" class="button-1">
                        Keep Current Date
                    </button>

                    <button type="button" id="btnChangeDate" class="button-1">
                        Change Date
                    </button>
                </div>

            </div>
        </div>

        <script asp-location="Footer">

            $(function () {
                $("#change-preorder-date-dialog").dialog({
                    autoOpen: false,
                    modal: true,
                    resizable: false,
                    draggable: false,
                    width: 480,
                    dialogClass: "preorder-confirm-dialog",
                    title: "",
                    closeOnEscape: false
                });
            });

            $(document).ready(function () {

                // hide panel initially
                if ($("input[name='OrderType']:checked").val() === "Regular") {
                    $(".preorder-panel").hide();
                }

                $(".order-card").on("click", function () {

                    $(".order-card").removeClass("active");
                    $(this).addClass("active");
                    $(this).find("input[type='radio']").prop("checked", true);
                    if ($(this).find("input[type='radio']").val() === "PreOrder") {

                        $(".preorder-panel")
                            .stop(true, true)
                            .slideDown(250);

                    } else {

                        $(".preorder-panel")
                            .stop(true, true)
                            .slideUp(250, function () {

                                $("#PreferredDeliveryDate").datepicker("setDate",
                                    currentPreferredDate ? currentPreferredDate : null);
                            });
                    }
                });
            });

            let pendingPreferredDate = null;
            let currentPreferredDate = $("#PreferredDeliveryDate").val();
            $("#btnKeepCurrentDate").on("click", function () {

                $("#PreferredDeliveryDate").datepicker("setDate", currentPreferredDate);

                pendingPreferredDate = null;

                $("#change-preorder-date-dialog").dialog("close");
            });

            $("#btnChangeDate").on("click", function () {

                currentPreferredDate = pendingPreferredDate;

                pendingPreferredDate = null;

                // Date is already selected, just close the dialog
                $("#change-preorder-date-dialog").dialog("close");
            });

        </script>

    </div>
    <div id="preorder-not-available"
         class="preorder-not-available-message"
         style="display:none;">
        <span>
            @T("Admin.Catalog.Preorders.PreorderNotAvailable")
        </span>
    </div>
}




