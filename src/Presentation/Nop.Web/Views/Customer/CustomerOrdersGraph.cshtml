@model List<Nop.Web.Controllers.CustomerController.Graph>
@using Nop.Core
@using Nop.Services.Customers;
@using Nop.Services.InvoicePaymentOptions;
@using Nop.Services.Configuration;
@inject ISettingService _settingService
@inject IWorkContext _workContext
@inject ICustomerService _customerService
@inject IInvoicePaymentOption _InvoicePaymentOptionService
@{
    Layout = "_ColumnsTwo";

    //title
    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-offlinetransactions-list-page");
}
@{
    var customer = _workContext.GetCurrentCustomerAsync().Result;
    var GetallRoles = _customerService.GetCustomerRolesAsync(customer).Result.Where(d => d.Name == "CAD B2C"
                || d.Name == "USD B2C"
                || d.Name == "USD B2B INTL"
                || d.Name == "CAD B2C HS"
                || d.Name == "USD B2B ST"
                || d.Name == "USD B2B DS"
                || d.Name == "CAD B2B ST"
                || d.Name == "CAD B2B DS"
                ).FirstOrDefault();
    var invoicepayments = _InvoicePaymentOptionService
     .GetAllInvoicePaymentOption()
     .Where(x => x.Active == true && x.CustomerRole.Split(',').Select(id => id.Trim()).Contains(GetallRoles.Id.ToString()))
     .Select(x => new
     {
         PaymentOption = x.paymentOption,
         PaynowButton = x.PaynowButton,
         PaynowOption = x.Paynowtoption
     })
     .ToList();
    var customerEmail = _workContext.GetCurrentCustomerAsync().Result.Email;
    // var PayNowButton = _InvoicePaymentOptionService.GetAllInvoicePaymentOption().Where(x => x.Active==true && x.CustomerRole.Split(',').Select(id => id.Trim()).Contains(GetallRoles.Id.ToString())).Select(x => x.PaynowButton).FirstOrDefault();
    // var PayNowOption = _InvoicePaymentOptionService.GetAllInvoicePaymentOption().Where(x => x.CustomerRole.Split(',').Select(id => id.Trim()).Contains(GetallRoles.Id.ToString())).Select(x => x.Paynowtoption).FirstOrDefault();
}
@section left
{
    @*Remove for UI/UX by Riz*@
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = CustomerNavigationEnum.Custosmerordergraph })
}
<div class="page-title">
    <h1 style="font-weight:bold;">My Dashboard</h1>
</div>

<div class="outstanding_box border_card">

    <div>

        <div style="font-weight:bold;font-size:17px;margin-bottom:10px;">
            Outstanding Account Balance: @ViewBag.TotalOutstandingPayment.ToString("C")
        </div>

        <div style="font-size:14px;">
            Outstanding Invoices: @ViewBag.OutstandingInvoices.ToString("C")
        </div>

        <div style="font-size:14px;margin-bottom:5px;">
            Account Credit: -@ViewBag.AccountCredits.ToString("C")
        </div>
        @if (@ViewBag.TotalOutstandingPayment > 0)
        {



            @if (invoicepayments.FirstOrDefault()?.PaynowButton == true)
            {
                var bpCode = ViewBag.customerBpcode;
                <div>
                    @T("offlinetransaction.GraphWithPayButton")
                </div>
                <div style="font-size:14px; margin-top: 10px">
                    <div>@T("offlinetransaction.textforpaybutton")</div>
                    <div>Bpcode: @bpCode</div>
                </div>
                <br />
                <input type="button" class="button-1 paynowbutton" onclick="location.href='https://hansamed.net/paymentinvoice?bpCode=@bpCode&site=Citagenix'" value="@T("OfflineTransaction.PayNow")" />
            }
            
        }
        else
        {

            <div>@T("offlinetransaction.GraphWithoutPayButton")</div>
        }
    </div>
    <div>
        @if (invoicepayments.FirstOrDefault()?.PaynowOption == true)
        {
            @Html.Raw(invoicepayments.FirstOrDefault().PaymentOption)
        }
    </div>


</div>

@* <div class="outstanding_box border_card">
    <h2>Reward Points</h2>

    <div><strong>@T("RewardPoints.CurrentBalance", ViewBag.RewardPointsBalance, ViewBag.RewardPointsAmount) <a style="text-decoration: underline;" href="/rewardpoints/history">Click here for more details</a></strong></div>
</div> *@

<div class="graphouter">
    @foreach (var i in Model)
    {
        @await Html.PartialAsync("_CustomerOrdersGraph1", i)
    }
    @* @await Html.PartialAsync("~/areas/admin/views/home/_latestorders.cshtml") *@

</div>
<div class="tableouter">
    @await Html.PartialAsync("_Latestorderwithrefund")
    @await Html.PartialAsync("_BestsellerByQuantity")
    <div id="targetDiv"></div>
