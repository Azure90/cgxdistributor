</style>
<script>
    $(document).ready(function () {
        const requestData = { data: "partial" };
        $.ajax({
            url: '/ShoppingCart/Wishlist', // Controller and Action URL
            type: 'GET',
            data: requestData,
            success: function (data) {
                // Append the returned HTML to the target div
                $("#targetDiv").html(data);
            },
            error: function (xhr, status, error) {
                console.error("Error occurred: " + error);
            }
        });
        $.ajax({
            url: '/Product/CompareProducts', // Controller and Action URL
            type: 'GET',
            data: requestData,
            success: function (data) {
                // Append the returned HTML to the target div
                $("#Compareproducts").html(data);
            },
            error: function (xhr, status, error) {
                console.error("Error occurred: " + error);
            }
        });

    });
</script>
