        alert(invoiceid, invType);
        // Additional JavaScript code can be added here
    }

</script>


<script type="text/javascript">
    //
    $(document).ready(function () {

        $.noConflict();
        $("#invoice").DataTable(
            {
                "searching": true,
                "responsive": true,
                "ordering": false,
                //"paging": false,
                "lengthMenu": [[100, 200, 300, 400, 500], [100, 200, 300, 400, 500]],
            }
        );
        //Get a reference to the new datatable
        // var table = $('#invoice').DataTable();
        //Take the category filter drop down and append it to the datatables_filter div.
        //You can use this same idea to move the filter anywhere withing the datatable that you want.
        $("#invoice_filter.dataTables_filter").append($("#divcategoryFilter"));
        //You can use this same idea to move the filter anywhere withing the datatable that you want.
        $("#invoice_filter.dataTables_filter").append($("#divYearFilter"));
    });
    $(".ddlchangeevent").change(function () {
        var year = $("#yearFilter").val();
        var customerEmail = $("#hdncustomerEmail").val();
        var Bpcode = $("#hdncustomerBpcode").val();
        var type = $("#categoryFilter").val()
        $.ajax({
            type: "Get",
            caches: false,
            url: '@Url.Action("GetAllTransactionInvoicesYear", "Customer")',
            data: {
                Bpcode: Bpcode, email: customerEmail, Selectedyear: year, type: type
            },
            success: function (data) {

                $("#tbodyaccountbalance").html("");
                $("#tbodyaccountbalance").html(data.innerhtml);

            },
        });
    });
</script> 