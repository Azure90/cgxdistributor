<script>
        // Function to redirect after a specified time
        function redirectToSpecificPage() {
            var count = 10; // Number of seconds for the countdown
            var countdownTimer = setInterval(function () {
                count--;
                $('#countdown').text(count);
                if (count <= 0) {
                    clearInterval(countdownTimer);
                    // Replace 'specific-page-url' with the URL you want to redirect to
                    window.location.href = 'https://hansamed.net/paymentinvoice';
                    //alert("hii");
                }
            }, 1000); // Update every second
        }

    // Call the function when the page loads
    window.onload = redirectToSpecificPage;
    
    $('#click').click(function () {
        window.location.href = 'https://hansamed.net/paymentinvoice';
    });
</script> 