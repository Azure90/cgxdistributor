<style type="text/css">

    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .button-invoice {
        width: 100px;
        margin: 0px;
    }

    input[type="number"], input[type="text"] {
        height: 36px;
        border: 1px solid #e9e9e9;
        padding: 0 8px;
        vertical-align: middle;
        color: #777;
        margin-left: 10px;
    }

    td {
        padding: 5px;
    }

    .inputs input {
        width: 100%;
        max-width: 100%;
        vertical-align: middle;
        height: 36px;
        border: 1px solid #e9e9e9;
        padding: 0 8px;
        vertical-align: middle;
        color: #777;
    }

    .custlabel {
        width: 200px;
        font-weight: bolder;
    }









    /* Style the modal */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
    }

    /* Style the modal content */
    .modal-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: #fff;
        padding: 40px; /* Increased padding for a larger modal */
        border-radius: 10px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
        max-width: 600px; /* Increased max-width for a larger modal */
        width: 100%;
        font-size: 22px;
    }

    /* Style the close button */
    .close {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 20px;
        color: #555;
        cursor: pointer;
    }

    /* Style the Open Modal button */
    #myModalBtn {
        padding: 10px 15px;
        font-size: 16px;
        cursor: pointer;
        background-color: #4CAF50;
        color: #fff;
        border: none;
        border-radius: 5px;
    }

        #myModalBtn:hover {
            background-color: #45a049;
        }

    .Paymentinvoice {
        text-align: center;
        padding-top:32px;
    }

        .Paymentinvoice h1 {
            color: #323232;
            text-align: center;
            font-size: 30px;
            line-height: 1.3;
            margin: 0 0 20px;
        }

        .Paymentinvoice p {
            color: #323232;
            font-size: 20px;
            font-weight: 600;
            margin: 0 0 20px;
        }

        .Paymentinvoice #click {
            font-size: 20px;
            text-decoration: underline;
        }

        .Paymentinvoice #click:hover {
                color: #a3da40;
        }

        .Paymentinvoice h3, .Paymentinvoice h2 {
            color: #323232;
            text-align: center;           
            margin: 0 0 20px;
        }
</style>
<div class="Paymentinvoice">
    
    <h2>We appreciate your patience!</h2><h2> Your payment invoice page will be automatically redirected shortly.</h2><br /><h3>
        Alternatively, feel free to
        click on the provided link for immediate access..</h3>
    <p>Redirecting in <span id="countdown">10</span> seconds</p>
    <a id="click">Click here</a>
    </div>
