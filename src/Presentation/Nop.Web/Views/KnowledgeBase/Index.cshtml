        <script>
            $(".accordion-button").click(function () {
                const target = $(this).data("target");
                $(this).toggleClass("active")
                $(`[data-id="${target}"]`).slideToggle().toggleClass("active");
            })


        </script>

        <script>
            $(".kb-sidebar .menu > li > a").click(function () {

                var $parentListItem = $(this).parent();

                if ($parentListItem.hasClass("active")) {
                    return; // Do nothing if the clicked menu item is already active
                }

                $(".kb-sidebar .menu > li").removeClass("active");
                $parentListItem.addClass("active");

                // Wait for the transition to complete before removing the "active" class from other menu items
                setTimeout(function () {
                    $(".kb-sidebar .menu > li").not($parentListItem).removeClass("active");
                }, 300); // Adjust the duration (in milliseconds) to match your CSS transition time
            });
            $(function () {
                var $items = $(".kb-sidebar .menu li.products");

                $items.on("mouseenter", function () {
                    var $li = $(this);

                    // Close other items only if they don't have an active .subInnerItems
                    $items.not($li).each(function () {
                        var $other = $(this);
                        if (!$other.find(".subInnerItems.active").length) {
                            $other.removeClass("active")
                                .find("> ul").stop(true, true).slideUp(150);
                        }
                    });

                    // Open the hovered item
                    $li.addClass("active")
                        .find("> ul").stop(true, true).slideDown(150);
                });
            });


            $(document).on("click", "#partialanswer", function (e) {

                $(".subInnerItems").removeClass("active");
                $(this).addClass("active");

                $(".products").each(function () {
                    if ($(this).find(".subInnerItems.active").length === 0) {
                        $(this).removeClass("active");
                    } else {
                        $(this).addClass("active");
                    }
                });
                var pageName = $(this).data("pagename");
                var subCat = $(this).data("subcat");
                var subtitleId = $(this).data("subtitle");
                $.ajax({
                    type: 'get',
                    url: '/KnowledgeBase/Partialquestionanswer',
                    data: {
                        PageNameID: pageName,
                        pagesubcategory: subCat,
                        SubtitleId: subtitleId
                    },
                    success: function (data) {
                        $('.content-container')[0].scrollIntoView({
                            behavior: 'smooth', // smooth scrolling
                            block: 'start'      // align to top of viewport
                        });
                        $('#partialContainer').html(data);                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
                        $(".collapse").css("display", "block");
                    },
                    // complete: function () {
                    //     $("#loader-overlay").hide();
                    // },
                })
            })




            $(document).ready(function () {
                // debugger






                var Subtitle = '@ViewBag.Subtitle';

                var pagesubcategory = '@ViewBag.pagesubcategory';

                pagesubcategory = $("<div>").html(pagesubcategory).text();
                Subtitle = $("<div>").html(Subtitle).text();



                $(".Question_" + pagesubcategory + Subtitle).click();


            });
            $(window).scroll(function () {
                var scroll = $(window).scrollTop();

                if (scroll >= 100) {
                    $("body").addClass("sidebar-is-sticky");
                } else {
                    $("body").removeClass("sidebar-is-sticky");
                }
            });
            $(function () {
                $(".mobileview").click(function () {
                    if ($(".kb-sidebar").hasClass("mobilesidebar")) {
                        $(".kb-sidebar").removeClass("mobilesidebar");
                    } else {
                        $(".kb-sidebar").addClass("mobilesidebar");
                    }
                });
            });
            setTimeout(function () {
                if (!$(".Question_BillingGeneral").hasClass("active")) {
                    $(".Question_BillingGeneral ").click();
                }
            }, 1000);
        </script>
    </div>




